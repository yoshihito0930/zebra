---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { getEntry } from 'astro:content';

// レンタル機材データを取得
const rentalData = await getEntry('rental', 'equipment');
const { items } = rentalData?.data ?? { items: [] };
---

<BaseLayout title="レンタル機材 | スタジオゼブラ">
  <PageHeader
    title="レンタル機材"
    subtitle="スタジオゼブラの貸し出し機材は充実のラインナップ。<br>ライティングの可能性が広がります。"
    pageClass="rental"
  />

  <section>
    <!-- レンタル機材一覧 -->
    <div id="lead-rental">
      <div class="wrap">
        <h2 class="ttl-common wow fadeInUp">レンタル機材一覧</h2>
        <div class="list">
          {items.map((item) => (
            <div class="item wow fadeInUp">
              <p class="photo"><img src={item.image} alt={item.text}></p>
              <p class="text">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ダウンロードセクション -->
    <div id="download-flie">
      <div class="wrap">
        <p class="btn wow fadeInUp">
          <a href="/pdf/equipment-list.pdf" target="_blank" download>
            <img src="/img/rental/btn_dowload.webp" alt="機材一覧をダウンロード">
          </a>
        </p>
        <p class="file-size wow fadeInUp">PDF <span>76KB</span></p>
      </div>
    </div>

    <!-- 消耗品（有料） -->
    <div id="sec01-rental">
      <div class="wrap">
        <h2 class="ttl-common wow fadeInUp">消耗品（有料）</h2>
        <dl class="wow fadeInUp">
          <dt><span>●</span> 背景紙（2.72m）</dt>
          <dd class="right-t">¥2,300（税込¥2,530）/1m</dd>
        </dl>
        <p class="txt wow fadeInUp">
          常設カラー・・・<br>
          ブラック、ダブグレー、ペールブルー、ウィート、アップルグリーン、カナリー、<br>レッド、ピンク
        </p>
        <p class="photo wow fadeInUp">
          <img src="/img/rental/img_color.webp" alt="消耗品（有料）">
        </p>
        <dl class="wow fadeInUp">
          <dt><span>●</span> トレーシングペーパー1100</dt>
          <dd>¥200(税込¥220)/1m</dd>
        </dl>
        <dl class="wow fadeInUp">
          <dt><span>●</span> トレーシングペーパー2200</dt>
          <dd>¥700(税込¥770)/1m</dd>
        </dl>
        <dl class="wow fadeInUp">
          <dt><span>●</span> ユポ2200</dt>
          <dd>¥2,000(税込¥2,200)/1m</dd>
        </dl>
        <dl class="wow fadeInUp">
          <dt><span>●</span> タフニール1830</dt>
          <dd>¥700(税込¥770)/1m</dd>
        </dl>
        <dl class="wow fadeInUp">
          <dt><span>●</span> ケント紙（四六判）白・黒・グレー</dt>
          <dd>¥300(税込¥330)/1枚</dd>
        </dl>
        <p class="note wow fadeInUp">
          レンタル機材や備品は、状況により内容が変更される場合がございますので事前にご確認ください
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ページヘッダー */
  .page-all.rental {
    background: url(/img/rental/key_rental.webp) no-repeat center center;
    background-size: cover;
    height: 455px;
    position: relative;
  }

  /* レンタル機材一覧セクション */
  #lead-rental {
    padding: 60px 0;
  }

  .ttl-common {
    text-align: center;
    margin-bottom: 40px;
    font-size: 36px;
  }

  #lead-rental .list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin: 0 auto;
  }

#lead-rental .list .item {
  margin: 0 12px;
  max-width: 284px;
  position: relative;
}

  #lead-rental .item {
    text-align: center;
  }

  #lead-rental .item .photo {
    margin-bottom: 15px;
    overflow: hidden;
    border-radius: 8px;
  }

  #lead-rental .item .photo img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #lead-rental .item:hover .photo img {
    transform: scale(1.05);
  }

  #lead-rental .item .text {
    font-size: 16px;
    line-height: 1.6;
    color: #333;
    white-space: pre-line;
  }

  /* ダウンロードセクション */
  #download-flie {
    padding: 40px 0;
    text-align: center;
  }

  #download-flie .btn {
    margin-bottom: 15px;
  }

  #download-flie .btn img {
    max-width: 100%;
    height: auto;
    transition: opacity 0.3s ease;
  }

  #download-flie .btn a:hover img {
    opacity: 0.8;
  }

  #download-flie .file-size {
    font-size: 14px;
    color: #000;
  }

  #download-flie .file-size span {
    font-weight: bold;
    color: #000;
  }

  /* 消耗品セクション */
  #sec01-rental {
    padding: 60px 0;
  }

  #sec01-rental .ttl-common {
    margin-bottom: 40px;
  }

  #sec01-rental dl {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #sec01-rental dl dt {
    flex: 1;
    font-weight: normal;
    position: relative;
    padding-left: 20px;
  }

  #sec01-rental dl dt span {
    position: absolute;
    left: 0;
    color: #82C2A9;
    font-weight: bold;
  }

  #sec01-rental dl dd {
    flex: 0 0 auto;
    text-align: right;
    font-weight: bold;
    color: #000;
  }

  #sec01-rental dl dd.right-t {
  }

  #sec01-rental .txt {
    line-height: 1.8;
    color: #000;
  }

  #sec01-rental .photo {
    text-align: center;
  }

  #sec01-rental .photo img {
    max-width: 100%;
    height: auto;
  }

  #sec01-rental .note {
    font-size: 16px;
    color: #000;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    .page-all.rental {
      height: 305px;
    }

    #lead-rental .list {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #lead-rental .list .item {
      margin: 0 auto;
      max-width: 100%;
    }

    #lead-rental .item .photo img {
      height: 250px;
    }

    #sec01-rental dl {
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }

    #sec01-rental dl dd {
      text-align: left;
      padding-left: 20px;
    }
  }
</style>
