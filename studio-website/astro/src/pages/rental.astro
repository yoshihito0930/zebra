---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="レンタル機材 | スタジオゼブラ">
  <div id="head-top" class="page-all rental">
    <div class="key-page">
      <h1><span>レンタル機材</span></h1>
      <h2 class="ttl-key-page"><span>スタジオ利用料に含まれる機材一覧</span></h2>
    </div>
    <div class="head-info">
      <p class="logo"><a href="/"><img src="/img/shared/logo_fix.png" alt="ロゴ"></a></p>
      <ul class="nav-h">
        <li><a href="/studio/"><img src="/img/shared/gnav01.png" alt="スタジオ案内"></a></li>
        <li><a href="/price/"><img src="/img/shared/gnav02.png" alt="料金案内"></a></li>
        <li class="active"><a href="/rental/"><img src="/img/shared/gnav03.png" alt="レンタル機材"></a></li>
        <li><a href="/access/"><img src="/img/shared/gnav04.png" alt="アクセス"></a></li>
        <li><a href="/faq/"><img src="/img/shared/gnav_a1.png" alt="よくある質問"></a></li>
        <li><a href="/horizon/"><img src="/img/shared/gnav_a2.png" alt="ホリゾントルール"></a></li>
        <li><a href="/reservation/"><img src="/img/shared/gnav05.png" alt="ご予約・お問い合わせ"></a></li>
        <li><a href="/news/"><img src="/img/shared/gnavi_news.png" alt="news"></a></li>
        <li><a href="/blog/"><img src="/img/shared/gnavi_blog.png" alt="ブログ"></a></li>
        <li><a href="https://twitter.com/studiozebra1st" target="_blank"><img src="/img/shared/gnavi_tw.png" alt="twitter"></a></li>
      </ul>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="content-page">
        <h2 class="ttl-common">貸出機材</h2>
        <p>スタジオ内のすべての機材が使い放題です。</p>
        <p>（有料の消耗品・LEDライトを除く）</p>
        <p class="note-text">※詳細は<a href="/reservation">お問い合わせ</a>ください。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-all.rental {
    background: url(/img/common/key_rental.jpg) no-repeat center center;
    background-size: cover;
  }
  .content-page {
    padding: 60px 0;
    text-align: center;
  }
  .ttl-common {
    font-size: 32px;
    margin-bottom: 30px;
  }
  .content-page p {
    margin: 15px 0;
    font-size: 16px;
  }
  .note-text a {
    color: #82C2A9;
    text-decoration: underline;
  }
</style>
