---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';

const IMG = '/images/rental';

// 01 ストロボ・ジェネレーター（公式サイトで確認済み）
const generators = [
  { name: 'CS-2400T',   note: '最大 2400Ws', count: 1 },
  { name: 'CM-1200T',   note: '最大 1200Ws', count: 1 },
  { name: 'CSb-1200TⅡ', note: '最大 1200Ws', count: 1 },
] as const;

const heads = [
  { name: 'CB-25H', note: '2500Ws / 100V専用', count: 6 },
  { name: 'CAX-H',  note: '',                  count: 1 },
] as const;

const strobeExtras = ['シンクロコード', 'ヘッド延長コード'] as const;

// 02 ライティング機材（3列）
const lighting = [
  { img: 'octa.webp',         name: 'ソフトボックス／オクタ φ120', sub: '× 1' },
  { img: 'rect-softbox.webp', name: 'ソフトボックス／レクタ',      sub: '× 1' },
  { img: 'umbrella.webp',     name: 'アンブレラ',                  sub: '直径60cm × 5／直径180cm × 1' },
  { img: 'reflector.webp',    name: 'カポック・パネル・レフ',      sub: '白黒カポック 3×6判 × 4／白黒Ｌパネル 3×8判 × 2／レフ（銀・白）× 1／フラッグ × 2' },
  { img: 'grid.webp',         name: 'ハニカムグリッド',            sub: '× 2' },
  { img: 'radioslave.webp',   name: 'ラジオスレーブ',              sub: '× 1' },
] as const;

// 03 スタンド・グリップ（5列）
const grip = [
  { img: 'stand.webp',          name: 'ライトスタンド・ブーム', sub: '東芝ライテックミニスタンド × 6／アベンジャースタンド40インチ × 3／スーパーブーム × 1' },
  { img: 'autopole.webp',       name: 'オートポール',           sub: '× 6／エクステンションチューブ 2m × 2・1.5m × 2' },
  { img: 'weight.webp',         name: 'ウエイト',               sub: '10kg × 4／5kg × 2' },
  { img: 'clamp.webp',          name: 'クランプ・クリップ',     sub: 'ダブルクランプ × 4／エレンクリップ × 9' },
  { img: 'extension-cord.webp', name: '延長コード',             sub: '× 3' },
] as const;

// 04 スタジオ備品（4列）
const studio = [
  { img: 'stepladder.webp',        name: '脚立',                       sub: '大 × 1／小 × 1' },
  { img: 'tripod.webp',            name: '三脚・雲台',                 sub: '各 × 1' },
  { img: 'minitable.webp',         name: 'ミニテーブル',               sub: '× 2' },
  { img: 'wood-table.webp',        name: 'セットホース／フラットパネル', sub: 'セットホース × 1／フラットパネル 3×6判 × 1' },
  { img: 'chair.webp',             name: '椅子',                       sub: '× 6' },
  { img: 'stool.webp',             name: '丸椅子',                     sub: '× 4' },
  { img: 'hangerrack-mirror.webp', name: 'ハンガーラック・鏡',         sub: 'ラック × 2／鏡 × 1' },
  { img: 'applebox.webp',          name: 'サイコロ・箱馬',             sub: '500mm角 × 2／250mm角 × 7／箱馬 × 4' },
  { img: 'wagon.webp',             name: 'ワゴン',                     sub: '× 1' },
  { img: 'blower.webp',            name: 'ブロワー',                   sub: '× 1' },
  { img: 'speaker.webp',           name: 'Bluetooth スピーカー',       sub: '× 1' },
] as const;

const photoGroups = [
  { num: '02', title: 'ライティング機材', en: 'LIGHT MODIFIERS',     cols: 3, items: lighting },
  { num: '03', title: 'スタンド・グリップ', en: 'STANDS / GRIP',       cols: 5, items: grip },
  { num: '04', title: 'スタジオ備品',     en: 'STUDIO ACCESSORIES', cols: 4, items: studio },
] as const;

// 05 別途料金のオプション
const setpaperColors = [
  { name: 'ブラック',       hex: '#2B2B2B' },
  { name: 'ダブグレー',     hex: '#8B8B84' },
  { name: 'ペールブルー',   hex: '#74C3D5' },
  { name: 'ウィート',       hex: '#D9B36C' },
  { name: 'アップルグリーン', hex: '#7CC25E' },
  { name: 'カナリー',       hex: '#F5D533' },
  { name: 'レッド',         hex: '#9C1F30' },
  { name: 'ピンク',         hex: '#F59BB4' },
] as const;

const otherPapers = [
  { name: 'トレーシングペーパー 1100',         base: '¥200',   incl: '¥220',   unit: '/ 1m' },
  { name: 'トレーシングペーパー 2200',         base: '¥700',   incl: '¥770',   unit: '/ 1m' },
  { name: 'ユポ 2200',                         base: '¥2,000', incl: '¥2,200', unit: '/ 1m' },
  { name: 'タフニール 1830',                   base: '¥700',   incl: '¥770',   unit: '/ 1m' },
  { name: 'ケント紙（四六判）白・黒・グレー', base: '¥300',   incl: '¥330',   unit: '/ 1枚' },
] as const;
---

<BaseLayout title="レンタル機材 | スタジオゼブラ" pageClass="rental">
  <PageHeader
    title="レンタル機材"
    subtitle="<span class='catch'>機材は、使い放題。</span><br>COMET ジェネレーター 3 台 ＆ ヘッド 7 灯をはじめ、ライティングのアクセサリーから三脚・スピーカーまで。ご利用料金内で、まるごとお使いいただけます。"
    pageClass="rental"
    variant="v2"
    eyebrow="RENTAL EQUIPMENT"
  />

  <div class="brand-v2 page-rental">
    <div class="container-narrow">

      {/* 01 ストロボ・ジェネレーター */}
      <section aria-labelledby="sec-strobe">
        <header class="section-header">
          <span class="sec-num">01</span>
          <h2 id="sec-strobe" class="t-h3">ストロボ・ジェネレーター</h2>
          <span class="label-en">STROBE / GENERATOR</span>
        </header>

        <div class="strobe-grid">
          <div class="strobe-photo card-pop">
            <div class="strobe-photo-img" style={`background-image:url('${IMG}/generator.webp')`}></div>
          </div>

          <div class="spec-card">
            <div class="spec-block">
              <div class="label-en">COMET / GENERATOR</div>
              <div class="spec-heading">ジェネレーター ×3台</div>
              <ul class="spec-list">
                {generators.map((g) => (
                  <li class="spec-row">
                    <span class="spec-name"><b>{g.name}</b><span class="spec-note">{g.note}</span></span>
                    <span class="spec-count">× {g.count}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="spec-block">
              <div class="label-en">COMET / HEAD</div>
              <div class="spec-heading">ヘッド ×7台</div>
              <ul class="spec-list">
                {heads.map((h) => (
                  <li class="spec-row">
                    <span class="spec-name"><b>{h.name}</b>{h.note && <span class="spec-note">{h.note}</span>}</span>
                    <span class="spec-count">× {h.count}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="spec-tags">
              {strobeExtras.map((c) => <span class="spec-tag">{c}</span>)}
            </div>
          </div>
        </div>
      </section>

      {/* 02–04 写真グリッド */}
      {photoGroups.map((group) => (
        <section aria-label={group.title}>
          <header class="section-header">
            <span class="sec-num">{group.num}</span>
            <h2 class="t-h3">{group.title}</h2>
            <span class="label-en">{group.en}</span>
          </header>
          <div class={`equip-photo-grid cols-${group.cols}`}>
            {group.items.map((it) => (
              <div class="equip-photo-card">
                <div class="equip-photo-img" style={`background-image:url('${IMG}/${it.img}')`}></div>
                <div class="equip-photo-body">
                  <div class="equip-name">{it.name}</div>
                  {it.sub && <div class="equip-sub">{it.sub}</div>}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      {/* 05 別途料金のオプション */}
      <section aria-labelledby="sec-paid">
        <header class="section-header">
          <span class="sec-num">05</span>
          <h2 id="sec-paid" class="t-h3">別途料金のオプション</h2>
          <span class="label-en">PAID OPTIONS</span>
        </header>

        {/* 背景紙 */}
        <div class="paid-card">
          <div class="paid-card-head">
            <div class="paid-card-title">
              <span class="pill-red">別途料金</span>
              <span class="paid-name">背景紙（2.72m）</span>
            </div>
            <div class="paid-price">
              <span class="paid-price-num">¥2,300</span>
              <span class="paid-price-tax">（税込 ¥2,530）/ 1m</span>
            </div>
          </div>
          <div class="paid-card-body">
            <div class="swatch-label">常設カラー（8色）</div>
            <div class="swatch-grid">
              {setpaperColors.map((c) => (
                <div class="swatch">
                  <div class="swatch-chip" style={`background:${c.hex}`}></div>
                  <div class="swatch-name">{c.name}</div>
                </div>
              ))}
            </div>
            <p class="swatch-foot">その他の色はお取り寄せ可能な場合がありますので、ご相談ください。</p>
          </div>
        </div>

        {/* その他の紙類 */}
        <div class="paper-card">
          <div class="paper-card-head">その他の紙類</div>
          <ul class="paper-list">
            {otherPapers.map((p) => (
              <li class="paper-row">
                <span class="paper-name"><span class="paper-bullet">●</span>{p.name}</span>
                <span class="paper-price">
                  <b>{p.base}</b>
                  <span class="muted">（税込 {p.incl}）{p.unit}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <p class="paid-note">
          ※ レンタル機材や備品は、状況により内容が変更される場合がございますので事前にご確認ください。
        </p>
        <p class="pdf-link">
          <a href={`${IMG}/equipment-list.pdf`} download="スタジオゼブラ_機材一覧.pdf">
            機材一覧（PDF）をダウンロード
          </a>
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
