---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import CategoryList from '../../components/CategoryList.astro';
import Pagination from '../../components/Pagination.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // 1ページあたり6記事表示
  return paginate(sortedPosts, { pageSize: 6 });
};

const { page } = Astro.props;
const allPosts = await getCollection('blog');

// カテゴリ一覧を取得
const categories = [...new Set(allPosts.map(post => post.data.category))];
---

<BaseLayout title="ブログ | スタジオゼブラ">
  <div id="head-top" class="page-all blog">
    <div class="key-page">
      <h1 class="wow fadeInUp"><span>BLOG</span></h1>
      <h2 class="ttl-key-page wow fadeInUp">
        <span>スタジオの最新情報やお得なキャンペーン、</span><br>
        <span>撮影テクニックをお届けします。</span>
      </h2>
    </div>
  </div>

  <section class="blog-container">
    <div class="wrap">
      <div class="blog-layout">
        <aside class="sidebar">
          <CategoryList categories={categories} />
        </aside>

        <main class="blog-main">
          <div class="blog-grid">
            {page.data.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                slug={post.slug}
              />
            ))}
          </div>

          {page.lastPage > 1 && (
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl="/blog"
            />
          )}
        </main>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ページヘッダー */
  .page-all.blog {
    background: url(/img/common/key_blog.webp) no-repeat center center;
    background-size: cover;
    height: 455px;
    position: relative;
  }

  .key-page {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 100%;
    z-index: 10;
  }

  .key-page h1 span {
    color: #FFF;
    background: #000;
    min-width: 260px;
    display: inline-block;
    margin-bottom: 20px;
    letter-spacing: 0.2em;
    padding: 15px 25px;
    font-size: 30px;
  }

  .ttl-key-page span {
    border-bottom: 2px solid;
    font-size: 24px;
    line-height: 48px;
    font-weight: bold;
  }

  /* ブログコンテナ */
  .blog-container {
    padding: 60px 0;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 40px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    .page-all.blog {
      height: 305px;
    }

    .key-page h1 span {
      font-size: 5.5vw;
      padding: 10px 15px;
    }

    .ttl-key-page span {
      font-size: 3.7vw;
      line-height: 38px;
    }

    .blog-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      order: 2;
    }

    .blog-main {
      order: 1;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
