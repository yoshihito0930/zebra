---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SidebarCategoryList from '../../components/SidebarCategoryList.astro';
import Pagination from '../../components/Pagination.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // 1ページあたり6記事表示
  return paginate(sortedPosts, { pageSize: 6 });
};

const { page } = Astro.props;
const allPosts = await getCollection('blog');

// カテゴリ一覧を取得
const categories = [...new Set(allPosts.map(post => post.data.category))];
---

<BaseLayout title="ブログ | スタジオゼブラ">
  <div id="head-top" class="page-all blog">
    <div class="key-page">
      <h1 class="wow fadeInUp"><span>BLOG</span></h1>
      <h2 class="ttl-key-page wow fadeInUp">
        <span>スタジオの最新情報やお得なキャンペーン、</span><br>
        <span>撮影テクニックをお届けします。</span>
      </h2>
    </div>
  </div>

  <section class="blog-container">
    <div class="wrap">
      <div class="blog-layout">
        <aside class="sidebar">
          <SidebarCategoryList
            categories={categories}
            heading="カテゴリ"
            baseUrl="/blog"
          />
        </aside>

        <main class="blog-main">
          <div class="blog-grid">
            {page.data.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                slug={post.slug}
                baseUrl="/blog"
              />
            ))}
          </div>

          {page.lastPage > 1 && (
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl="/blog"
            />
          )}
        </main>
      </div>
    </div>
  </section>
</BaseLayout>
