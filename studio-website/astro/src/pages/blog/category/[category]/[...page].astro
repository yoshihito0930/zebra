---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import SidebarCategoryList from '../../../../components/SidebarCategoryList.astro';
import Pagination from '../../../../components/Pagination.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const categories = [...new Set(allPosts.map(post => post.data.category))];

  // カテゴリごとにページネーション
  return categories.flatMap(category => {
    const filteredPosts = allPosts
      .filter(post => post.data.category === category)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filteredPosts, {
      params: { category },
      pageSize: 6,
      props: { allCategories: categories, categoryName: category },
    });
  });
};

const { page } = Astro.props;
const { category } = Astro.params;
const { allCategories, categoryName } = Astro.props;
---

<BaseLayout title={`${categoryName} | ブログ | スタジオゼブラ`}>
  <div id="head-top" class="page-all blog">
    <div class="key-page">
      <h1 class="wow fadeInUp"><span>BLOG</span></h1>
      <h2 class="ttl-key-page wow fadeInUp">
        <span>カテゴリ: {categoryName}</span><br>
        <span>{page.total}件の記事</span>
      </h2>
    </div>
  </div>

  <section class="blog-container">
    <div class="wrap">
      <div class="blog-layout">
        <aside class="sidebar">
          <SidebarCategoryList
            categories={allCategories}
            currentCategory={categoryName}
            heading="カテゴリ"
            baseUrl="/blog"
          />
        </aside>

        <main class="blog-main">
          <div class="blog-grid">
            {page.data.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                slug={post.slug}
                baseUrl="/blog"
              />
            ))}
          </div>

          {page.lastPage > 1 && (
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl={`/blog/category/${category}`}
            />
          )}
        </main>
      </div>
    </div>
  </section>
</BaseLayout>
