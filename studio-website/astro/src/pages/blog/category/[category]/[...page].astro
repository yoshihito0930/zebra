---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogCard from '../../../../components/BlogCard.astro';
import CategoryList from '../../../../components/CategoryList.astro';
import Pagination from '../../../../components/Pagination.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const categories = [...new Set(allPosts.map(post => post.data.category))];

  // カテゴリごとにページネーション
  return categories.flatMap(category => {
    const filteredPosts = allPosts
      .filter(post => post.data.category === category)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filteredPosts, {
      params: { category },
      pageSize: 6,
      props: { allCategories: categories, categoryName: category },
    });
  });
};

const { page } = Astro.props;
const { category } = Astro.params;
const { allCategories, categoryName } = Astro.props;
---

<BaseLayout title={`${categoryName} | ブログ | スタジオゼブラ`}>
  <div class="blog-header">
    <div class="wrap">
      <h1>カテゴリ: {categoryName}</h1>
      <p>{page.total}件の記事</p>
    </div>
  </div>

  <section class="blog-container">
    <div class="wrap">
      <div class="blog-layout">
        <aside class="sidebar">
          <CategoryList categories={allCategories} currentCategory={categoryName} />
        </aside>

        <main class="blog-main">
          <div class="blog-grid">
            {page.data.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                slug={post.slug}
              />
            ))}
          </div>

          {page.lastPage > 1 && (
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl={`/blog/category/${category}`}
            />
          )}
        </main>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    background: linear-gradient(135deg, #82C2A9 0%, #6BA896 100%);
    color: #fff;
    padding: 60px 0;
    text-align: center;
  }

  .blog-header h1 {
    font-size: 36px;
    margin-bottom: 15px;
  }

  .blog-header p {
    font-size: 16px;
    opacity: 0.9;
  }

  .blog-container {
    padding: 60px 0;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 40px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }

  @media (max-width: 768px) {
    .blog-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      order: 2;
    }

    .blog-main {
      order: 1;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-header h1 {
      font-size: 28px;
    }
  }
</style>
