---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);
---

<BaseLayout title={`${post.data.title} | ブログ | スタジオゼブラ`} description={post.data.description}>
  <article class="blog-post">
    <div class="wrap">
      <header class="post-header">
        <div class="post-meta">
          <span class="category">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="post-content">
        <Content />
      </div>

      <footer class="post-footer">
        <a href="/blog" class="back-link">← ブログ一覧に戻る</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding: 60px 0;
  }

  .post-header {
    margin-bottom: 40px;
    padding-bottom: 30px;
    border-bottom: 2px solid #e0e0e0;
  }

  .post-meta {
    display: flex;
    gap: 15px;
    align-items: center;
    margin-bottom: 20px;
  }

  .category {
    background: #82C2A9;
    color: #fff;
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
  }

  time {
    color: #666;
    font-size: 14px;
  }

  .post-header h1 {
    font-size: 32px;
    line-height: 1.4;
    margin-bottom: 15px;
  }

  .post-description {
    font-size: 18px;
    color: #666;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tag {
    background: #f5f5f5;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    color: #666;
  }

  .post-content {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
    font-size: 16px;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 40px;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .post-content :global(h1) {
    font-size: 28px;
  }

  .post-content :global(h2) {
    font-size: 24px;
    padding-bottom: 10px;
    border-bottom: 2px solid #82C2A9;
  }

  .post-content :global(h3) {
    font-size: 20px;
  }

  .post-content :global(p) {
    margin-bottom: 20px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-left: 25px;
    margin-bottom: 20px;
  }

  .post-content :global(li) {
    margin-bottom: 10px;
  }

  .post-content :global(a) {
    color: #82C2A9;
    text-decoration: underline;
  }

  .post-content :global(strong) {
    font-weight: bold;
  }

  .post-footer {
    margin-top: 60px;
    padding-top: 30px;
    border-top: 2px solid #e0e0e0;
  }

  .back-link {
    color: #82C2A9;
    text-decoration: none;
    font-weight: bold;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 24px;
    }

    .post-description {
      font-size: 16px;
    }

    .post-content {
      font-size: 15px;
    }
  }
</style>
