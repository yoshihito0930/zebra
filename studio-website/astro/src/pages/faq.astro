---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { getEntry } from 'astro:content';

// FAQデータを取得
const faqData = await getEntry('faq', 'questions');
if (!faqData) {
  throw new Error('FAQ data not found');
}
const { categories } = faqData.data;
---

<BaseLayout title="よくある質問 | スタジオゼブラ">
  <PageHeader
    title="よくある質問"
    subtitle="よくお問い合わせいただくご質問と、その回答をご紹介します。"
    pageClass="faq"
    variant="v2"
    eyebrow="FAQ"
  />

  <div class="brand-v2 page-faq">
    <section id="faq-body">
      <div class="container-narrow">
        <div class="faq-cats">
          {categories.map((category, catIndex) => (
            <div class="faq-cat">
              <h2 class="faq-cat-title">
                <span class="faq-cat-num">{String(catIndex + 1).padStart(2, '0')}</span>
                {category.title}
              </h2>
              <div class="faq-list">
                {category.questions.map((qa) => (
                  <details class="faq-item card">
                    <summary class="faq-q">
                      <span class="faq-mark faq-mark-q" aria-hidden="true">Q</span>
                      <span class="faq-q-text">{qa.question}</span>
                      <span class="faq-chevron" aria-hidden="true">⌄</span>
                    </summary>
                    <div class="faq-a">
                      <span class="faq-mark faq-mark-a" aria-hidden="true">A</span>
                      <p class="faq-a-text" set:html={qa.answer}></p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .brand-v2.page-faq {
    background: #fff;
    color: var(--ink-1);
    font-family: var(--font-body);
  }

  #faq-body {
    padding: var(--s-7) 0 var(--s-8);
  }

  /* カテゴリ全体 */
  .brand-v2.page-faq .faq-cats {
    display: grid;
    gap: var(--s-7);
  }

  /* カテゴリ見出し（連番ピル + タイトル） */
  .brand-v2.page-faq .faq-cat-title {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin: 0 0 var(--s-4);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20px;
    line-height: 1.4;
    color: var(--ink-1);
    /* shared.css のグローバル header の position/z-index を打ち消し、固定ナビと干渉させない */
    position: static;
    z-index: auto;
  }

  .brand-v2.page-faq .faq-cat-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: var(--r-pill);
    background: var(--brand-mint);
    color: var(--brand-black);
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 12px;
  }

  /* Q&A リスト */
  .brand-v2.page-faq .faq-list {
    display: grid;
    gap: var(--s-3);
  }

  /* アコーディオン（ネイティブ details） */
  .brand-v2.page-faq .faq-item {
    overflow: hidden;
    padding: 0;
  }

  .brand-v2.page-faq .faq-item[open] {
    box-shadow: var(--shadow-2);
  }

  /* 質問（summary） */
  .brand-v2.page-faq .faq-q {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding: 16px 18px;
    background: #fff;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background var(--d-micro) var(--ease-out);
  }

  .brand-v2.page-faq .faq-q::-webkit-details-marker {
    display: none;
  }

  .brand-v2.page-faq .faq-item[open] .faq-q {
    background: var(--paper-1);
  }

  .brand-v2.page-faq .faq-q-text {
    flex: 1;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.6;
    color: var(--ink-1);
  }

  /* Q / A マーク */
  .brand-v2.page-faq .faq-mark {
    flex-shrink: 0;
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.4;
  }

  .brand-v2.page-faq .faq-mark-q {
    color: var(--brand-red);
  }

  .brand-v2.page-faq .faq-mark-a {
    color: var(--brand-mint);
    padding-top: 12px;
  }

  /* 開閉シェブロン */
  .brand-v2.page-faq .faq-chevron {
    flex-shrink: 0;
    font-size: 18px;
    line-height: 1.2;
    color: var(--ink-3);
    transition: transform var(--d-trans) var(--ease-out);
  }

  .brand-v2.page-faq .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  /* 回答 */
  .brand-v2.page-faq .faq-a {
    display: flex;
    gap: var(--s-3);
    padding: 4px 18px 18px;
    border-top: 1px solid var(--line-2);
  }

  .brand-v2.page-faq .faq-a-text {
    flex: 1;
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.95;
    color: var(--ink-2);
  }

  .brand-v2.page-faq .faq-a-text a {
    color: var(--brand-red);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity var(--d-micro) var(--ease-out);
  }

  .brand-v2.page-faq .faq-a-text a:hover {
    opacity: 0.7;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    #faq-body {
      padding: var(--s-6) 0 var(--s-7);
    }

    .brand-v2.page-faq .faq-cats {
      gap: var(--s-6);
    }

    .brand-v2.page-faq .faq-cat-title {
      font-size: 18px;
    }

    .brand-v2.page-faq .faq-q {
      padding: 14px 16px;
    }

    .brand-v2.page-faq .faq-q-text {
      font-size: 14px;
    }

    .brand-v2.page-faq .faq-a {
      padding: 4px 16px 16px;
    }

    .brand-v2.page-faq .faq-a-text {
      font-size: 13.5px;
    }
  }
</style>
