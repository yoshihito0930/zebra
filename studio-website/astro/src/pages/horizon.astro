---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ホリゾントルール | スタジオゼブラ">
  <div id="head-top" class="page-all horizon">
    <div class="key-page">
      <h1><span>ホリゾントルール</span></h1>
      <h2 class="ttl-key-page"><span>白ホリゾント利用時のルール</span></h2>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="content-page">
        <h2 class="ttl-common">ホリゾントルール</h2>
        <p>白ホリゾントを綺麗に保つため、ご協力をお願いいたします。</p>
        <p class="note-text">詳細は<a href="/reservation">お問い合わせ</a>ください。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-all.horizon {
    background: #82C2A9;
  }
  .content-page {
    padding: 60px 0;
    text-align: center;
  }
  .content-page p {
    margin: 20px 0;
  }
  .note-text a {
    color: #333;
    text-decoration: underline;
  }
</style>
