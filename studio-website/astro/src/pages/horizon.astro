---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ホリゾントルール | スタジオゼブラ">
  <div id="head-top" class="page-all horizon">
    <div class="key-page">
      <h1><span>ホリゾントルール</span></h1>
      <h2 class="ttl-key-page"><span>白ホリゾント利用時のルール</span></h2>
    </div>
    <div class="head-info">
      <p class="logo"><a href="/"><img src="/img/shared/logo_fix.png" alt="ロゴ"></a></p>
      <ul class="nav-h">
        <li><a href="/studio/"><img src="/img/shared/gnav01.png" alt="スタジオ案内"></a></li>
        <li><a href="/price/"><img src="/img/shared/gnav02.png" alt="料金案内"></a></li>
        <li><a href="/rental/"><img src="/img/shared/gnav03.png" alt="レンタル機材"></a></li>
        <li><a href="/access/"><img src="/img/shared/gnav04.png" alt="アクセス"></a></li>
        <li><a href="/faq/"><img src="/img/shared/gnav_a1.png" alt="よくある質問"></a></li>
        <li class="active"><a href="/horizon/"><img src="/img/shared/gnav_a2.png" alt="ホリゾントルール"></a></li>
        <li><a href="/reservation/"><img src="/img/shared/gnav05.png" alt="ご予約・お問い合わせ"></a></li>
        <li><a href="/news/"><img src="/img/shared/gnavi_news.png" alt="news"></a></li>
        <li><a href="/blog/"><img src="/img/shared/gnavi_blog.png" alt="ブログ"></a></li>
        <li><a href="https://twitter.com/studiozebra1st" target="_blank"><img src="/img/shared/gnavi_tw.png" alt="twitter"></a></li>
      </ul>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="content-page">
        <h2 class="ttl-common">ホリゾントルール</h2>
        <p>白ホリゾントを綺麗に保つため、ご協力をお願いいたします。</p>
        <p class="note-text">詳細は<a href="/reservation">お問い合わせ</a>ください。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-all.horizon {
    background: #82C2A9;
  }
  .content-page {
    padding: 60px 0;
    text-align: center;
  }
  .content-page p {
    margin: 20px 0;
  }
  .note-text a {
    color: #333;
    text-decoration: underline;
  }
</style>
