---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { getEntry } from 'astro:content';

// スタジオデータを取得
const studioData = await getEntry('studio', 'main');
const { popups, gallery } = studioData?.data ?? { popups: [], gallery: [] };
---

<BaseLayout title="スタジオ案内 | スタジオゼブラ">
  <PageHeader
    title="スタジオ案内"
    subtitle="天高3m超・引き9mの白ホリスタジオ。<br>あなたのスタジオワークをもっと自由に、快適に。"
    pageClass="studio"
    variant="v2"
    eyebrow="STUDIO"
  />

  <section>
    <!-- スタジオ紹介セクション -->
    <div id="lead-studio">
      <div class="wrap">
        <h2 class="ttl-common">
          <img src="/img/studio/studio.svg" width="784" alt="ABOUT OUR STUDIO STUDIOZEBRA!">
        </h2>

        <div class="studio-box">
          <p class="photo">
            <img src="/img/studio/img_studio.webp" alt="スタジオ写真">
          </p>
          <dl>
            <dt><span>ゆったり！</span></dt>
            <dd>
              複数箇所から狙えるホリゾントが特徴。<br>
              ３mを超える天井高と９mの引きがありモデルの全身撮影にも適しています。
            </dd>
          </dl>
        </div>

        <h3>
          <img src="/img/studio/title_details.webp" alt="平面図">
        </h3>

        <div class="studio-detail">
          <!-- PC版: 左側のポップアップ表示エリア -->
          <div class="popup-display pc">
            {popups.map((popup) => (
              <div id={`display-${popup.id}`} class={`popup-content-static ${popup.id === 'A' ? 'active' : ''}`} data-popup-id={popup.id}>
                <div class="pp-box-st">
                  {popup.images.map((img) => (
                    <span><img src={img.src} alt={img.alt}></span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- 平面図マップ -->
          <div class="detail-map">
            <p class="map">
              <img src="/img/studio/map.webp" alt="MAP">
            </p>
            <button class="unit-a btn unsmooth" data-popup="A">Button</button>
            <button class="unit-b btn unsmooth" data-popup="B">Button</button>
            <button class="unit-c btn unsmooth" data-popup="C">Button</button>
            <button class="unit-d btn unsmooth" data-popup="D">Button</button>
            <button class="unit-e btn unsmooth" data-popup="E">Button</button>
            <button class="unit-f btn unsmooth" data-popup="F">Button</button>
          </div>

          <!-- モバイル版: ポップアップダイアログ -->
          {popups.map((popup) => (
            <dialog id={`popup-${popup.id}`} class="studio-popup">
              <div class="popup-content">
                <button class="popup-close" aria-label="閉じる">×</button>
                <div class="pp-box-st">
                  <dl>
                    <dt>
                      {popup.images.map((img) => (
                        <span><img src={img.src} alt={img.alt}></span>
                      ))}
                    </dt>
                  </dl>
                </div>
              </div>
            </dialog>
          ))}
        </div>

        <dl class="note">
          <dt>平面図のアイコン<span class="ft-add">A</span> 〜 <span class="ft-add">F</span>をクリックすると画像が表示されます</dt>
          <dd>※写真・間取り図と現況が相違する場合は、現況が優先されますので予めご了承下さい。</dd>
        </dl>
      </div>
    </div>

    <!-- フォトギャラリーセクション -->
    <div id="gallery-box">
      <div class="wrap">
        <h2 class="ft-add">
          <img src="/img/studio/photo_galery.svg" width="507" alt="PHOTO GALLERY">
        </h2>
        <h3 class="ttl-common">フォトギャラリー</h3>

        <!-- フォトギャラリー（グリッド表示。クリックで拡大） -->
        <ul class="gallery-grid">
          {gallery.map((item) => (
            <li>
              <button class="gallery-thumb" type="button" data-full={item.main} data-alt={item.alt}>
                <img src={item.thumbnail} alt={item.alt} loading="lazy">
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 拡大表示用ライトボックス -->
    <dialog id="gallery-lightbox" class="gallery-lightbox">
      <button class="gallery-lightbox-close" type="button" aria-label="閉じる">×</button>
      <img class="gallery-lightbox-img" src="" alt="">
    </dialog>
  </section>
</BaseLayout>

<style is:global>
  /* スタジオ紹介セクション */
  #lead-studio {
    padding: 60px 0;
  }

  /* ヘッダーの zebra-band (.container-narrow: max 760px / 左右 24px) と
     横幅を揃える */
  #lead-studio .wrap {
    max-width: 760px;
    padding: 0 24px;
  }

  .ttl-common {
    text-align: center;
    margin-bottom: 40px;
  }

  .studio-box {
    display: flex;
    gap: 40px;
    margin: 40px 0;
    align-items: center;
  }

  .studio-box .photo {
    flex: 1;
  }

  .studio-box .photo img {
    width: 100%;
    height: auto;
  }

  .studio-box dl {
    flex: 1;
  }

  .studio-box dt {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 15px;
  }

  .studio-box dt span {
    color: #82C2A9;
  }

  .studio-box dd {
    line-height: 1.8;
  }

  /* スタジオ詳細 */
  .studio-detail {
    position: relative;
  }

  .studio-detail .photo {
    margin-bottom: 30px;
  }

  /* PC版: 左右レイアウト */
  @media only screen and (min-width: 768px) {
    .studio-detail {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      gap: 40px;
      align-items: flex-start;
      justify-content: space-between;
    }

    .studio-detail .photo {
      display: none !important;
      order: 0;
    }

    .popup-display {
      width: 50% !important;
      flex-shrink: 0;
      order: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 500px;
    }

    .detail-map {
      width: 50% !important;
      flex-shrink: 0;
      order: 2;
      margin-top: 0 !important;
    }

    .popup-content-static {
      display: none;
    }

    .popup-content-static.active {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .popup-content-static .pp-box-st {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .popup-display .pp-box-st span {
      display: block;
    }

    .popup-display .pp-box-st img {
      width: 100%;
      height: auto;
      display: block;
    }
  }

  .studio-detail .show-box {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
  }

  .studio-detail .show-box p {
    flex: 1;
  }

  .studio-detail .show-box img {
    width: 100%;
    height: auto;
  }

  .detail-map {
    position: relative;
  }

  .detail-map .map img {
    width: 100%;
    height: auto;
  }

  .detail-map button {
    position: absolute;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background 0.3s ease;
  }

  .detail-map button:hover {
    background: rgba(130, 194, 169, 0.3);
  }

  /* ボタン位置（実際の平面図に合わせて調整） */
  .detail-map .unit-a { top: 13%; left: 4%; }
  .detail-map .unit-b { top: 34%; right: 20%; }
  .detail-map .unit-c { bottom: 35%; right: 37%; }
  .detail-map .unit-d { bottom: 40%; right: 22%; }
  .detail-map .unit-e { bottom: 21%; right: 45%; }
  .detail-map .unit-f { bottom: 20%; right: 15%; }

  /* ポップアップスタイル */
  .studio-popup {
    border: none;
    border-radius: 8px;
    padding: 0;
    width: 95vw;
    max-width: 1200px;
    max-height: 85vh;
    overflow: auto;

    /* 左右中央 + 下方向に配置 */
    position: fixed;
    left: 50%;
    top: 80px;
    transform: translateX(-50%);
    margin: 0;
  }

  .studio-popup::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .popup-content {
    position: relative;
    padding: 40px;
  }

  .popup-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #000;
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    transition: background 0.3s ease;
  }

  .popup-close:hover {
    background: #333;
  }

  .pp-box-st dl {
    display: flex;
    gap: 30px;
    align-items: flex-start;
  }

  .pp-box-st dt {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 10px;
  }

  .pp-box-st dt img {
    width: 100%;
    height: auto;
  }

  .pp-box-st dd {
    flex: 1;
    line-height: 1.8;
    font-size: 16px;
  }

  /* 注釈 */
  .note {
    margin-top: 40px;
    text-align: center;
  }

  .note dt {
    font-weight: bold;
    margin-bottom: 10px;
  }

  .note .ft-add {
    font-weight: bold;
  }

  .note dd {
    font-size: 14px;
    color: #666;
  }

  /* フォトギャラリー */
  #gallery-box {
    background: #82C2A9;
    padding: 60px 0;
  }

  /* ヘッダーの zebra-band (.container-narrow: max 760px / 左右 24px) と
     横幅を揃える */
  #gallery-box .wrap {
    max-width: 760px;
    padding: 0 24px;
  }

  #gallery-box h2 {
    text-align: left;
    margin-bottom: 20px;
  }

  #gallery-box h3.ttl-common {
    text-align: left;
    margin: 0;
    padding: 0;
  }

  /* フォトギャラリー グリッド */
  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .gallery-grid > li {
    margin: 0;
  }

  .gallery-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 4 / 3;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .gallery-thumb:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 拡大表示ライトボックス（画面中央に固定サイズで表示） */
  .gallery-lightbox {
    border: none;
    padding: 0;
    background: transparent;
    overflow: visible;

    /* どの画像も同じ大きさ・画面中央に表示する */
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    width: 80vw;
    height: 80vh;
    max-width: 1000px;
  }

  .gallery-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  .gallery-lightbox-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
    /* 新しい画像のデコード完了まで非表示にし、前の画像が残らないようにする */
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .gallery-lightbox-img.is-loaded {
    opacity: 1;
  }

  .gallery-lightbox-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: #000;
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.3s ease;
    z-index: 1;
  }

  .gallery-lightbox-close:hover {
    background: #333;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    /* モバイル版: PC用のポップアップ表示エリアを完全に非表示 */
    .popup-display {
      display: none !important;
    }

    /* モバイル版: studio-detailのレイアウト */
    .studio-detail {
      display: block;
    }

    .studio-detail .photo {
      display: none;
    }

    .detail-map {
      width: 100%;
      margin-top: 0;
    }

    .studio-box {
      flex-direction: column;
    }

    .studio-detail .show-box {
      flex-direction: column;
    }

    .pp-box-st dl {
      flex-direction: column;
    }

    .popup-content {
      padding: 20px;
    }

    .studio-popup {
      top: 60px;
      width: 95vw;
      max-height: 85vh;
    }

    /* モバイル版: ギャラリーグリッドを2列に */
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>

<script>
  // ポップアップ機能
  const popupButtons = document.querySelectorAll('[data-popup]');
  popupButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const popupId = button.getAttribute('data-popup');

      // PC版（768px以上）: 左側の表示を切り替え
      if (window.innerWidth >= 768) {
        // すべてのポップアップ表示を非表示
        const allDisplays = document.querySelectorAll('.popup-content-static');
        allDisplays.forEach((display) => {
          display.classList.remove('active');
        });

        // クリックされたエリアの表示を表示
        const targetDisplay = document.getElementById(`display-${popupId}`);
        if (targetDisplay) {
          targetDisplay.classList.add('active');
        }
      } else {
        // モバイル版（767px以下）: モーダル表示
        const dialog = document.getElementById(`popup-${popupId}`) as HTMLDialogElement;
        if (dialog) {
          dialog.showModal();
        }
      }
    });
  });

  // ポップアップを閉じる
  const closeButtons = document.querySelectorAll('.popup-close');
  closeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = button.closest('dialog') as HTMLDialogElement;
      if (dialog) {
        dialog.close();
      }
    });
  });

  // バックドロップクリックで閉じる
  const dialogs = document.querySelectorAll('.studio-popup');
  dialogs.forEach((dialog) => {
    (dialog as HTMLDialogElement).addEventListener('click', (e) => {
      const rect = (dialog as HTMLDialogElement).getBoundingClientRect();
      if (
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom
      ) {
        (dialog as HTMLDialogElement).close();
      }
    });
  });

  // フォトギャラリー: サムネイルクリックでライトボックス拡大
  const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const lightboxImg = lightbox?.querySelector('.gallery-lightbox-img') as HTMLImageElement | null;
  const lightboxClose = lightbox?.querySelector('.gallery-lightbox-close') as HTMLButtonElement | null;

  if (lightbox && lightboxImg) {
    const thumbButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');
    thumbButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const full = button.getAttribute('data-full') ?? '';
        const alt = button.getAttribute('data-alt') ?? '';

        // 前の画像が残らないよう、いったん非表示にしてから差し替える
        lightboxImg.classList.remove('is-loaded');
        lightboxImg.src = full;
        lightboxImg.alt = alt;
        lightbox.showModal();

        // 新しい画像のデコード完了後に表示する
        try {
          await lightboxImg.decode();
        } catch {
          // デコード失敗（中断等）は無視。fallback で表示する
        }
        lightboxImg.classList.add('is-loaded');
      });
    });

    // 閉じる時は次回のチラつき防止のため非表示状態に戻す
    const closeLightbox = () => {
      lightbox.close();
    };

    // Esc キーなど全ての閉じ方で非表示状態にリセットする
    lightbox.addEventListener('close', () => {
      lightboxImg.classList.remove('is-loaded');
    });

    // 閉じるボタン
    lightboxClose?.addEventListener('click', closeLightbox);

    // 背景クリックで閉じる
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });
  }
</script>
