---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import { getEntry } from 'astro:content';

// スタジオデータを取得
const studioData = await getEntry('studio', 'main');
const { popups, gallery } = studioData?.data ?? { popups: [], gallery: [] };
---

<BaseLayout title="スタジオ案内 | スタジオゼブラ">
  <PageHeader
    title="スタジオ案内"
    subtitle="天高3m超・引き9mの白ホリスタジオ。<br>あなたのスタジオワークをもっと自由に、快適に。"
    pageClass="studio"
  />

  <section>
    <!-- スタジオ紹介セクション -->
    <div id="lead-studio">
      <div class="wrap">
        <h2 class="ttl-common">
          <img src="/img/studio/studio.svg" width="784" alt="ABOUT OUR STUDIO STUDIOZEBRA!">
        </h2>

        <div class="studio-box">
          <p class="photo">
            <img src="/img/studio/img_studio.webp" alt="スタジオ写真">
          </p>
          <dl>
            <dt><span>ゆったり！</span></dt>
            <dd>
              複数箇所から狙えるホリゾントが特徴。<br>
              ３mを超える天井高と９mの引きがありモデルの全身撮影にも適しています。
            </dd>
          </dl>
        </div>

        <h3>
          <img src="/img/studio/title_details.webp" alt="平面図">
        </h3>

        <div class="studio-detail">
          <!-- PC版: 左側のポップアップ表示エリア -->
          <div class="popup-display pc">
            {popups.map((popup) => (
              <div id={`display-${popup.id}`} class={`popup-content-static ${popup.id === 'A' ? 'active' : ''}`} data-popup-id={popup.id}>
                <div class="pp-box-st">
                  {popup.images.map((img) => (
                    <span><img src={img.src} alt={img.alt}></span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- 平面図マップ -->
          <div class="detail-map">
            <p class="map">
              <img src="/img/studio/map.webp" alt="MAP">
            </p>
            <button class="unit-a btn unsmooth" data-popup="A">Button</button>
            <button class="unit-b btn unsmooth" data-popup="B">Button</button>
            <button class="unit-c btn unsmooth" data-popup="C">Button</button>
            <button class="unit-d btn unsmooth" data-popup="D">Button</button>
            <button class="unit-e btn unsmooth" data-popup="E">Button</button>
            <button class="unit-f btn unsmooth" data-popup="F">Button</button>
          </div>

          <!-- モバイル版: ポップアップダイアログ -->
          {popups.map((popup) => (
            <dialog id={`popup-${popup.id}`} class="studio-popup">
              <div class="popup-content">
                <button class="popup-close" aria-label="閉じる">×</button>
                <div class="pp-box-st">
                  <dl>
                    <dt>
                      {popup.images.map((img) => (
                        <span><img src={img.src} alt={img.alt}></span>
                      ))}
                    </dt>
                  </dl>
                </div>
              </div>
            </dialog>
          ))}
        </div>

        <dl class="note">
          <dt>平面図のアイコン<span class="ft-add">A</span> 〜 <span class="ft-add">F</span>をクリックすると画像が表示されます</dt>
          <dd>※写真・間取り図と現況が相違する場合は、現況が優先されますので予めご了承下さい。</dd>
        </dl>
      </div>
    </div>

    <!-- フォトギャラリーセクション -->
    <div id="gallery-box">
      <div class="wrap">
        <h2 class="ft-add">
          <img src="/img/studio/photo_galery.svg" width="507" alt="PHOTO GALLERY">
        </h2>
        <h3 class="ttl-common">フォトギャラリー</h3>

        <div class="slide-box">
          <!-- メインスライダー -->
          <div class="swiper gallery-main">
            <div class="swiper-wrapper">
              {gallery.map((item) => (
                <div class="swiper-slide">
                  <img src={item.main} alt={item.alt}>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- サムネイルスライダー -->
        <div class="th-box">
          <div class="swiper-button-prev"></div>
          <div class="swiper gallery-thumbs">
            <div class="swiper-wrapper">
              {gallery.map((item) => (
                <div class="swiper-slide">
                  <img src={item.thumbnail} alt={item.alt}>
                </div>
              ))}
            </div>
          </div>
          <div class="swiper-button-next"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style is:global>
  /* ページヘッダー */
  .page-all.studio {
    background: url(/img/studio/key_studio.webp) no-repeat center center;
    background-size: cover;
    height: 455px;
    position: relative;
  }

  /* スタジオ紹介セクション */
  #lead-studio {
    padding: 60px 0;
  }

  .ttl-common {
    text-align: center;
    margin-bottom: 40px;
  }

  .studio-box {
    display: flex;
    gap: 40px;
    margin: 40px 0;
    align-items: center;
  }

  .studio-box .photo {
    flex: 1;
  }

  .studio-box .photo img {
    width: 100%;
    height: auto;
  }

  .studio-box dl {
    flex: 1;
  }

  .studio-box dt {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 15px;
  }

  .studio-box dt span {
    color: #82C2A9;
  }

  .studio-box dd {
    line-height: 1.8;
  }

  /* スタジオ詳細 */
  .studio-detail {
    position: relative;
  }

  .studio-detail .photo {
    margin-bottom: 30px;
  }

  /* PC版: 左右レイアウト */
  @media only screen and (min-width: 768px) {
    .studio-detail {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      gap: 40px;
      align-items: flex-start;
      justify-content: space-between;
    }

    .studio-detail .photo {
      display: none !important;
      order: 0;
    }

    .popup-display {
      width: 50% !important;
      flex-shrink: 0;
      order: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 500px;
    }

    .detail-map {
      width: 50% !important;
      flex-shrink: 0;
      order: 2;
      margin-top: 0 !important;
    }

    .popup-content-static {
      display: none;
    }

    .popup-content-static.active {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .popup-content-static .pp-box-st {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .popup-display .pp-box-st span {
      display: block;
    }

    .popup-display .pp-box-st img {
      width: 100%;
      height: auto;
      display: block;
    }
  }

  .studio-detail .show-box {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
  }

  .studio-detail .show-box p {
    flex: 1;
  }

  .studio-detail .show-box img {
    width: 100%;
    height: auto;
  }

  .detail-map {
    position: relative;
  }

  .detail-map .map img {
    width: 100%;
    height: auto;
  }

  .detail-map button {
    position: absolute;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background 0.3s ease;
  }

  .detail-map button:hover {
    background: rgba(130, 194, 169, 0.3);
  }

  /* ボタン位置（実際の平面図に合わせて調整） */
  .detail-map .unit-a { top: 13%; left: 4%; }
  .detail-map .unit-b { top: 34%; right: 20%; }
  .detail-map .unit-c { bottom: 35%; right: 37%; }
  .detail-map .unit-d { bottom: 40%; right: 22%; }
  .detail-map .unit-e { bottom: 21%; right: 45%; }
  .detail-map .unit-f { bottom: 20%; right: 15%; }

  /* ポップアップスタイル */
  .studio-popup {
    border: none;
    border-radius: 8px;
    padding: 0;
    max-width: 90%;
    max-height: 90vh;
    overflow: auto;
  }

  .studio-popup::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .popup-content {
    position: relative;
    padding: 40px;
  }

  .popup-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #000;
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    transition: background 0.3s ease;
  }

  .popup-close:hover {
    background: #333;
  }

  .pp-box-st dl {
    display: flex;
    gap: 30px;
    align-items: flex-start;
  }

  .pp-box-st dt {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .pp-box-st dt img {
    width: 100%;
    height: auto;
  }

  .pp-box-st dd {
    flex: 1;
    line-height: 1.8;
    font-size: 16px;
  }

  /* 注釈 */
  .note {
    margin-top: 40px;
    text-align: center;
  }

  .note dt {
    font-weight: bold;
    margin-bottom: 10px;
  }

  .note .ft-add {
    font-weight: bold;
  }

  .note dd {
    font-size: 14px;
    color: #666;
  }

  /* フォトギャラリー */
  #gallery-box {
    background: #82C2A9;
    padding: 60px 0;
  }

  #gallery-box h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  #gallery-box h3 {
    text-align: center;
    margin-bottom: 40px;
  }

  .slide-box {
    margin-bottom: 20px;
  }

  .gallery-main {
    width: 100%;
    margin-bottom: 20px;
  }

  .gallery-main .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .th-box .swiper-button-prev,
  .th-box .swiper-button-next {
    width: 50px;
    height: 50px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    font-size: 0;
    color: transparent;
  }

  .th-box .swiper-button-prev {
    background-image: url(/img/studio/arrow_r.webp);
  }

  .th-box .swiper-button-next {
    background-image: url(/img/studio/arrow_l.webp);
  }

  .th-box .swiper-button-prev::after,
  .th-box .swiper-button-next::after {
    display: none;
  }

  .gallery-thumbs {
    width: 100%;
  }

  .gallery-thumbs .swiper-slide {
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .gallery-thumbs .swiper-slide-thumb-active {
    opacity: 1;
  }

  .gallery-thumbs .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    .page-all.studio {
      height: 305px;
    }

    /* モバイル版: PC用のポップアップ表示エリアを完全に非表示 */
    .popup-display {
      display: none !important;
    }

    /* モバイル版: studio-detailのレイアウト */
    .studio-detail {
      display: block;
    }

    .studio-detail .photo {
      display: none;
    }

    .detail-map {
      width: 100%;
      margin-top: 0;
    }

    .studio-box {
      flex-direction: column;
    }

    .studio-detail .show-box {
      flex-direction: column;
    }

    .pp-box-st dl {
      flex-direction: column;
    }

    .popup-content {
      padding: 20px;
    }
  }

</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Thumbs } from 'swiper/modules';

  // ポップアップ機能
  const popupButtons = document.querySelectorAll('[data-popup]');
  popupButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const popupId = button.getAttribute('data-popup');

      // PC版（768px以上）: 左側の表示を切り替え
      if (window.innerWidth >= 768) {
        // すべてのポップアップ表示を非表示
        const allDisplays = document.querySelectorAll('.popup-content-static');
        allDisplays.forEach((display) => {
          display.classList.remove('active');
        });

        // クリックされたエリアの表示を表示
        const targetDisplay = document.getElementById(`display-${popupId}`);
        if (targetDisplay) {
          targetDisplay.classList.add('active');
        }
      } else {
        // モバイル版（767px以下）: モーダル表示
        const dialog = document.getElementById(`popup-${popupId}`) as HTMLDialogElement;
        if (dialog) {
          dialog.showModal();
        }
      }
    });
  });

  // ポップアップを閉じる
  const closeButtons = document.querySelectorAll('.popup-close');
  closeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = button.closest('dialog') as HTMLDialogElement;
      if (dialog) {
        dialog.close();
      }
    });
  });

  // バックドロップクリックで閉じる
  const dialogs = document.querySelectorAll('.studio-popup');
  dialogs.forEach((dialog) => {
    (dialog as HTMLDialogElement).addEventListener('click', (e) => {
      const rect = (dialog as HTMLDialogElement).getBoundingClientRect();
      if (
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom
      ) {
        (dialog as HTMLDialogElement).close();
      }
    });
  });

  // Swiperギャラリー
  const galleryThumbs = new Swiper('.gallery-thumbs', {
    spaceBetween: 10,
    slidesPerView: 4,
    freeMode: true,
    watchSlidesProgress: true,
    breakpoints: {
      320: {
        slidesPerView: 3,
      },
      768: {
        slidesPerView: 4,
      },
      1024: {
        slidesPerView: 6,
      },
    },
  });

  const galleryMain = new Swiper('.gallery-main', {
    modules: [Navigation, Thumbs],
    spaceBetween: 10,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    thumbs: {
      swiper: galleryThumbs,
    },
  });

</script>
