---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SidebarCategoryList from '../../components/SidebarCategoryList.astro';
import Pagination from '../../components/Pagination.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allNews = await getCollection('news');
  const sortedNews = allNews.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // 1ページあたり6記事表示
  return paginate(sortedNews, { pageSize: 6 });
};

type Props = {
  page: Page<CollectionEntry<'news'>>;
};

const { page } = Astro.props;
const allNews = await getCollection('news');

// カテゴリ一覧を取得
const categories = [...new Set(allNews.map(news => news.data.category))];
---

<BaseLayout title="NEWS | スタジオゼブラ">
  <div id="head-top" class="page-all news">
    <div class="key-page">
      <h1 class="wow fadeInUp"><span>NEWS</span></h1>
      <h2 class="ttl-key-page wow fadeInUp">
        <span>スタジオゼブラからのお知らせです。</span>
      </h2>
    </div>
  </div>

  <section class="news-container">
    <div class="wrap">
      <div class="news-layout">
        <aside class="sidebar">
          <SidebarCategoryList
            categories={categories}
            heading="ニュース"
            baseUrl="/news"
          />
        </aside>

        <main class="news-main">
          <div class="news-grid">
            {page.data.map((news) => (
              <ArticleCard
                title={news.data.title}
                description={news.data.description}
                pubDate={news.data.pubDate}
                category={news.data.category}
                slug={news.slug}
                image={news.data.image}
                baseUrl="/news"
                readMoreText="...［すべて表示］"
              />
            ))}
          </div>

          {page.lastPage > 1 && (
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl="/news"
            />
          )}
        </main>
      </div>
    </div>
  </section>
</BaseLayout>
