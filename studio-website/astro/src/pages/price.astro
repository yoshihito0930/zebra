---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="料金案内 | スタジオゼブラ">
  <div id="head-top" class="page-all price">
    <div class="key-page">
      <h1 class="wow fadeInUp"><span>料金案内</span></h1>
      <h2 class="ttl-key-page wow fadeInUp">
        <span>新宿エリアの安くてきれいなレンタル撮影スタジオ。</span><br>
        <span>シンプルな料金設定です。</span>
      </h2>
    </div>
  </div>

  <section>
    <div id="lead">
      <div class="wrap">
        <!-- タイトル -->
        <h3 class="ttl-common wow fadeInUp title-price b-none">
          <span><font size="6">スタジオ利用料</font></span>
        </h3>

        <!-- メインプラン -->
        <div class="lead-banner is-price mt">
          <div class="list-price">
            <div class="item wow fadeInLeft">
              <p class="photo_price">
                <img src="/img/price/bnr_price_main.png" alt="main plan">
              </p>
            </div>
            <div class="item is-item wow fadeInRight">
              <div class="box">
                <p class="text1">最低利⽤時間／2時間</p>
                <p class="text">
                  スタジオ内のすべての機材が使えます︕<br>
                  （有料の消耗品・LEDライトを除く）
                </p>
                <p class="btn1">
                  <a href="/rental/">
                    <img src="/img/index/zebra_240704_item04.png" alt="貸出機材の詳細はこちら">
                  </a>
                </p>
                <p class="price-add-1807">
                  ＊深夜帯（23時〜翌8時）は、通常料⾦の50%UP<br>
                  ＊深夜帯を含む場合の最低利⽤時間／4時間<br>
                  ＊6⼈以上でのワークショップでご利⽤<br>
                  ・・・合計のご利⽤料に＋2,200円（税込）<br>
                  ＊ラメ、グリッターを多⽤した⾐装・⼩道具をご使⽤<br>
                  ・・・合計のご利⽤料に＋2,200円（税込）
                </p>
              </div>
            </div>
          </div>

          <!-- 機材保険セクション -->
          <div class="list-price price-old">
            <div class="item wow fadeInLeft">
              <p class="photo_price">
                <img src="/img/price/bnr_price_EquipmentInsurance.png" alt="EquipmentInsurance">
              </p>
            </div>
            <div class="item is-item wow fadeInRight">
              <div class="box">
                <p class="text">
                  お客様の不注意による機材の破損を保証します。<br>
                  （免責&yen;10,000、1機材に限ります）<br>
                  但し、ホリゾントを破損・汚損した場合の<br class="pc">
                  修繕費用と休業補償は含みません。
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 注意事項リスト -->
        <ul class="text-list-note wow fadeInUp">
          <li><span>●</span> 深夜帯（23時〜翌8時）は通常のご利用料金の<span>50%UP</span></li>
          <li><span>●</span> ゴミの回収は45リットルのゴミ袋1袋につき¥330(税込)にて回収いたします。分別できていないごみと粗⼤ごみ、⽣花⽤のオアシスは回収できません</li>
          <li><span>●</span> 機材の持ち込み料は原則かかりません。</li>
          <li><span>●</span> HMIをお持ち込みの場合は、1台あたり¥1,100(税込)/1hの持ち込み料をお支払いいただきます。<br>お持ち込み可能なHMIの電力量は1台1.2kw以下、総電力量は2.5kwまでです。</li>
        </ul>

        <!-- キャンセル料セクション PC版 -->
        <div class="price-note-edit pc">
          <h3 class="ttl-common wow fadeInUp">
            キャンセル料について
            <span>※本予約確定後は、ご利⽤⽇までの⽇数に応じてキャンセル料が発⽣します。</span>
          </h3>
          <div class="list wow fadeInUp">
            <dl>
              <dt>ご利⽤⽇の6⽇以前〜4⽇前</dt>
              <dd>ご予約時間分の利用料の50%</dd>
            </dl>
            <dl>
              <dt>ご利用日の3日前〜前日</dt>
              <dd>ご予約時間分の利用料の80%</dd>
            </dl>
            <dl>
              <dt>ご利用日当日</dt>
              <dd>ご予約時間分の利用料の100%</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- キャンセル料セクション SP版 -->
    <div class="price-note-edit sp">
      <div class="wrap">
        <h3 class="ttl-common wow fadeInUp">
          キャンセル料について
          <span>※本予約確定後は、ご利⽤⽇までの⽇数に応じてキャンセル料が発⽣します。</span>
        </h3>
        <div class="list wow fadeInUp">
          <dl>
            <dt>ご利⽤⽇の6⽇以前〜4⽇前</dt>
            <dd>ご予約時間分の利用料の50%</dd>
          </dl>
          <dl>
            <dt>ご利用日の3日前〜前日</dt>
            <dd>ご予約時間分の利用料の80%</dd>
          </dl>
          <dl>
            <dt>ご利用日当日</dt>
            <dd>ご予約時間分の利用料の100%</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ページヘッダー */
  .page-all.price {
    background: url(/img/price/key_price.jpg) no-repeat center center;
    background-size: cover;
    height: 455px;
    position: relative;
  }

  .key-page {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 100%;
    z-index: 10;
  }

  .key-page h1 span {
    color: #FFF;
    background: #000;
    min-width: 260px;
    display: inline-block;
    margin-bottom: 20px;
    letter-spacing: 0.2em;
    padding: 15px 25px;
    font-size: 30px;
  }

  .ttl-key-page span {
    border-bottom: 2px solid;
    font-size: 24px;
    line-height: 48px;
    font-weight: bold;
  }

  /* メインセクション - priceページ固有の調整 */
  /* #lead の共通スタイルは /styles/global/lead-section.css で定義 */

  /* 注意事項リスト */
  .text-list-note {
    list-style: none;
  }

  .text-list-note li {
    line-height: 1.8;
    position: relative;
    padding-left: 20px;
    text-indent: 0px;
  }

  .text-list-note li > span:first-child {
    position: absolute;
    left: 0;
    color: #FF463C;
  }

  .text-list-note li span {
    font-weight: bold;
  }

  /* キャンセル料セクション */
  .price-note-edit {
    background: #ffffff
  }

  .price-note-edit h3 {
    text-align: center;
  }

  .price-note-edit h3 span {
    display: block;
    font-size: 18x;
    font-weight: normal;
    color: #000
  }

  .price-note-edit .list {
    max-width: 800px;
    margin: 0 auto;
  }

  .price-note-edit dl {
    justify-content: space-between;
  }

  .price-note-edit dl:last-child {
    border-bottom: none;
  }

  .price-note-edit dt {
    font-weight: bold;
    flex: 1;
  }

  .price-note-edit dd {
    flex: 1;
    font-weight: bold;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    .page-all.price {
      height: 305px;
    }

    .key-page h1 span {
      font-size: 5.5vw;
      padding: 10px 15px;
    }

    .ttl-key-page span {
      font-size: 3.7vw;
      line-height: 38px;
    }

    #lead {
      padding: 30px 15px 30px;
    }

    #lead .wrap {
      padding: 40px 10px 50px;
    }

    .list-price {
      flex-direction: column;
    }

    .price-note-edit dl {
      flex-direction: column;
      gap: 10px;
    }

    .price-note-edit dd {
      text-align: center;
    }
  }
</style>
