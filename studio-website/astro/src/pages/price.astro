---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';

const tiers = [
  { range: '10名以下', base: '¥5,000', incl: '¥5,500', primary: true },
  { range: '11名以上', base: '¥5,500', incl: '¥6,050', primary: false },
] as const;

const nightRates = [
  { range: '10名以下', base: '¥7,500', incl: '¥8,250' },
  { range: '11名以上', base: '¥8,250', incl: '¥9,075' },
] as const;

const minTime = [
  { label: '通常帯のみのご利用', value: '2時間〜' },
  { label: '深夜帯を含む場合',   value: '4時間〜' },
] as const;

const addons = [
  { tag: '+¥2,200', label: '6名以上でのワークショップ利用',         sub: '合計料金に加算（税込）' },
  { tag: '+¥2,200', label: 'ラメ・グリッター等を多用する衣装・小道具', sub: '合計料金に加算（税込）' },
] as const;

const cancelTiers = [
  { when: 'ご利用日の6日以前〜4日前', fee: 'ご予約時間分の利用料の50%' },
  { when: 'ご利用日の3日前〜前日',     fee: 'ご予約時間分の利用料の80%' },
  { when: 'ご利用日当日',              fee: 'ご予約時間分の利用料の100%' },
] as const;

// §11 文体: 1 文 1 ルール、ヘッジ表現なし、終止形を統一
const notes = [
  '深夜帯（23:00〜翌8:00）は通常料金の50%UPでお願い致します。',
  '深夜帯を含むご利用の最低利用時間は4時間からとさせていただきます。',
  'ゴミは45リットル袋1袋につき¥330（税込）にて回収致します。',
  '分別できていないゴミ・粗大ゴミ・生花用オアシスはお持ち帰りください。',
  '機材の持ち込み料は原則無料です。',
  'HMIお持ち込みは1台あたり¥1,100（税込）／1hの持ち込み料を頂戴致します。',
  'お持ち込み可能なHMIは1台1.2kw以下・総電力量2.5kwまでとさせていただきます。',
];
---

<BaseLayout title="料金のご案内 | スタジオゼブラ" pageClass="price">
  <PageHeader
    title="料金のご案内"
    subtitle="ご利用人数で基本料金が変わります。"
    pageClass="price"
    variant="v2"
    eyebrow="PRICE"
  />

  <div class="brand-v2 page-price">
    <div class="container-narrow">

      {/* Section 1: 機材使い放題バナー */}
      <section aria-label="機材使い放題のご案内">
        <div class="price-hero-banner">
          <div class="zebra-stripe-overlay is-banner" aria-hidden="true"></div>
          <span class="badge-circle-red">機材<br />使い放題</span>
          <p class="banner-copy">どの料金プランでも、<span class="accent-mint">機材は使い放題。</span></p>
        </div>
      </section>

      {/* Section 2 + 3: 通常帯 */}
      <section aria-labelledby="rate-daytime-h">
        <header class="section-row">
          <h2 id="rate-daytime-h" class="t-h3">
            <span class="pill pill-black">通常帯</span>基本料金（8:00〜23:00）
          </h2>
          <span class="label-en">DAYTIME</span>
        </header>
        <div class="price-tier-grid">
          {tiers.map((t) => (
            <article
              class={`price-tier-card ${t.primary ? 'card-pop is-primary' : 'card'}`}
              aria-label={`${t.range} ${t.base} 税込${t.incl} 1時間あたり`}
            >
              {t.primary && <div class="zebra-stripe-overlay is-card" aria-hidden="true"></div>}
              <span class={t.primary ? 'pill-red' : 'pill-paper'}>{t.range}</span>
              <div class="price-line">
                <span class="price-num">{t.base}</span>
                <span class="price-unit">/ 1h</span>
              </div>
              <div class="price-tax">（税込 <b>{t.incl}</b>）</div>
            </article>
          ))}
        </div>
      </section>

      {/* Section 4 + 5: 深夜帯 */}
      <section aria-labelledby="rate-night-h">
        <header class="section-row">
          <h2 id="rate-night-h" class="t-h3">
            <span class="pill pill-navy">深夜帯</span>23:00〜翌8:00
            <span class="muted">通常料金の 50%UP</span>
          </h2>
          <span class="label-en">NIGHT</span>
        </header>
        <article class="card price-night-card">
          {nightRates.map((r) => (
            <div class="price-night-row">
              <span class="row-range">{r.range}</span>
              <span class="row-rate">
                <span class="price-num-sm">{r.base}</span>
                <span class="muted">/ 1h（税込 {r.incl}）</span>
              </span>
            </div>
          ))}
        </article>
      </section>

      {/* Section 6: 最低利用時間 + 追加料金 */}
      <div class="price-twocol-grid">
        <section class="card" aria-labelledby="min-hours-h">
          <header class="section-row">
            <h3 id="min-hours-h" class="t-h4">最低利用時間</h3>
            <span class="label-en">MIN. HOURS</span>
          </header>
          <ul class="price-rows">
            {minTime.map((m) => (
              <li class="price-row">
                <span class="row-label">{m.label}</span>
                <span class="row-value">{m.value}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="card" aria-labelledby="addons-h">
          <header class="section-row">
            <h3 id="addons-h" class="t-h4">追加料金が発生する場合</h3>
            <span class="label-en">ADD-ONS</span>
          </header>
          <ul class="price-rows">
            {addons.map((a) => (
              <li class="price-row addon-row">
                <span class="addon-tag">{a.tag}</span>
                <div>
                  <div>{a.label}</div>
                  <div class="addon-sub muted">{a.sub}</div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>

      {/* Section 7a: ご利用に関するご案内 (§11 文体) */}
      <section aria-labelledby="notes-h">
        <header class="section-row">
          <h2 id="notes-h" class="t-h3">ご利用に関するご案内</h2>
        </header>
        <ul class="rule-list">
          {notes.map((text) => <li>{text}</li>)}
        </ul>
      </section>

      {/* Section 7b: キャンセル料 */}
      <section aria-labelledby="cancel-h">
        <article class="card cancel-card">
          <header>
            <h2 id="cancel-h" class="t-h3">キャンセル料について</h2>
            <p class="muted">本予約確定後は、ご利用日までの日数に応じてキャンセル料が発生致します。</p>
          </header>
          <dl class="cancel-list">
            {cancelTiers.map((c) => (
              <>
                <dt>{c.when}</dt>
                <dd>{c.fee}</dd>
              </>
            ))}
          </dl>
        </article>
      </section>

      {/* CTA */}
      <div class="price-cta">
        <a href="/reservation/" class="btn btn-primary">ご予約はこちら</a>
      </div>

    </div>
  </div>
</BaseLayout>
