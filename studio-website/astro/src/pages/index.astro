---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="スタジオゼブラ | 新宿・代々木エリアの白ホリゾント撮影スタジオ"
  showReservationBanner={false}
>
  <div class="content">
    <h1>スタジオゼブラ</h1>
    <p>新宿・代々木エリアの白ホリゾント撮影スタジオ</p>
    <p>天高3m超・引き9mの白ホリスタジオ。あなたのスタジオワークをもっと自由に、快適に。</p>
  </div>
</BaseLayout>

<style>
  .content {
    min-height: 50vh;
    padding: 80px 20px;
    text-align: center;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }

  p {
    font-size: 1.2rem;
    margin: 10px 0;
  }
</style>
