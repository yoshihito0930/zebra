---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';

// ヒーロースライド画像（PC/SP出し分け）。新デザインの順序: 01 → 04 → 02 → 03
import slide01PC from '/public/img/index/slide01_pc_resize.webp';
import slide01SP from '/public/img/index/slide01_sp_resize.webp';
import slide04PC from '/public/img/index/slide04_pc.webp';
import slide04SP from '/public/img/index/slide04_sp.webp';
import slide02PC from '/public/img/index/slide02_pc_resize.webp';
import slide02SP from '/public/img/index/slide02_sp_resize.webp';
import slide03PC from '/public/img/index/slide03_pc_resize.webp';
import slide03SP from '/public/img/index/slide03_sp_resize.webp';

const heroSlides = [
  { pc: slide01PC, sp: slide01SP, width: 2071, height: 1165, alt: 'スタジオゼブラ 撮影風景' },
  { pc: slide04PC, sp: slide04SP, width: 1920, height: 1080, alt: 'スタジオゼブラ 白ホリゾント' },
  { pc: slide02PC, sp: slide02SP, width: 1954, height: 1099, alt: 'スタジオゼブラ 撮影風景' },
  { pc: slide03PC, sp: slide03SP, width: 2407, height: 1354, alt: 'スタジオゼブラ 撮影風景' },
];

// ABOUT 画像
import imgAbout1 from '/public/img/index/img_about1.webp';
import imgAbout2 from '/public/img/index/img_about2.webp';
import imgAbout3 from '/public/img/index/img_about3.webp';

// 料金（通常帯のみ。price.astro と同一の数値）
const tiers = [
  { range: '10名以下', base: '¥5,000', incl: '¥5,500', primary: true },
  { range: '11名以上', base: '¥5,500', incl: '¥6,050', primary: false },
] as const;

const nightRates = [
  { range: '10名以下', base: '¥7,500', incl: '¥8,250' },
  { range: '11名以上', base: '¥8,250', incl: '¥9,075' },
] as const;

const minTime = [
  { label: '通常帯のみのご利用', value: '2時間〜' },
  { label: '深夜帯を含む場合',   value: '4時間〜' },
] as const;

const addons = [
  { tag: '+¥2,200', label: '6名以上でのワークショップ利用',         sub: '合計料金に加算（税込）' },
  { tag: '+¥2,200', label: 'ラメ・グリッター等を多用する衣装・小道具', sub: '合計料金に加算（税込）' },
] as const;

// ABOUT OUR STUDIO 3 理由（HomePage.jsx の文言を踏襲）
const reasons = [
  {
    n: '01', k: 'エキチカ！', accent: 'var(--brand-red)', kColor: 'var(--brand-red)',
    title: '駅チカで、楽に通える',
    desc: 'JR代々木駅 東口から徒歩3分。新宿駅・新宿三丁目駅からも歩いて来られるので、機材が多い日も移動が楽です。',
    chip: '代々木駅 徒歩3分', img: imgAbout1, to: '/access/', cta: 'アクセスを見る',
  },
  {
    n: '02', k: 'ゆったり！', accent: 'var(--brand-mint)', kColor: 'var(--brand-mint-deep)',
    title: '広くて、天井が高い',
    desc: '天井高3m超・引き9mの白ホリゾント。被写体から距離をとれるので、全身撮影やライティングにゆとりがあります。',
    chip: '天井高3m / 引き9m', img: imgAbout2, to: '/studio/', cta: 'スタジオ案内を見る',
  },
  {
    n: '03', k: '思いのまま！', accent: 'var(--brand-red)', kColor: 'var(--brand-red)',
    title: '機材は無料で使い放題',
    desc: 'ストロボや各種スタンド、レフなどのレンタル機材を追加料金なしでご利用いただけます。ライティングも自由自在です。',
    chip: 'レンタル機材 ¥0', img: imgAbout3, to: '/rental/', cta: 'レンタル機材を見る',
  },
] as const;

// アクセス 徒歩分数カード
const walkCards = [
  { line: 'JR 代々木駅', exit: '東口より', num: '3', accent: 'var(--brand-red)' },
  { line: 'JR 新宿駅', exit: '新南口より', num: '7', accent: 'var(--brand-mint)' },
  { line: '東京メトロ丸ノ内線', exit: '新宿三丁目駅 E8出口より', num: '5', accent: 'var(--brand-red)' },
] as const;

// NEWS（最新4件）
const newsEntries = await getCollection('news');
const sortedNews = newsEntries
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatNewsDate = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

// カテゴリ → バッジ配色
const categoryBadge: Record<string, string> = {
  'メンテナンス': 'badge-danger',
  '営業情報': 'badge-warn',
  '機材': 'badge-success',
  'お知らせ': 'badge-info',
};
---

<BaseLayout
  title="スタジオゼブラ | 新宿・代々木エリアの白ホリゾント撮影スタジオ"
  showReservationBanner={false}
  pageClass="page-home"
>
  <div class="brand-v2 page-home">

    {/* ---------- HERO ---------- */}
    <section class="home-hero" id="head-top">
      <div class="hero-stage">
        <div class="hero-slides">
          {heroSlides.map((slide, index) => (
            <div class={`hero-slide${index === 0 ? ' is-active' : ''}`} data-slide>
              <picture class="pc">
                <Picture
                  src={slide.pc}
                  widths={[1024, 1440, 1920, 2400]}
                  sizes="100vw"
                  width={slide.width}
                  height={slide.height}
                  formats={['avif', 'webp']}
                  alt={slide.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </picture>
              <picture class="sp">
                <Picture
                  src={slide.sp}
                  widths={[375, 640, 750, 828]}
                  sizes="100vw"
                  width={slide.width}
                  height={slide.height}
                  formats={['avif', 'webp']}
                  alt={slide.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </picture>
            </div>
          ))}
        </div>
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="hero-copy">
          <div class="container">
            <span class="section-eyebrow hero-eyebrow">STUDIO ZEBRA</span>
            <h1 class="hero-title">新宿エリア × 高コスパ<br />白ホリスタジオ</h1>
            <p class="hero-lead">
              新宿・代々木エリアの白ホリゾント撮影スタジオ。<br />
              天高3m超・引き9m、機材は無料でお使いいただけます。
            </p>
          </div>
        </div>
        <div class="hero-dots" role="tablist" aria-label="ヒーロースライド">
          {heroSlides.map((_, index) => (
            <button
              type="button"
              class={`hero-dot${index === 0 ? ' is-active' : ''}`}
              data-dot
              aria-label={`スライド ${index + 1}`}
            ></button>
          ))}
        </div>
      </div>
      <div class="zebra-band"></div>
    </section>

    {/* ---------- PRICE ---------- */}
    <section class="home-section home-price">
      <div class="container-narrow">
        <div class="section-head">
          <span class="section-eyebrow">PRICE</span>
          <h2 class="section-title">料金のご案内</h2>
          <div class="zebra-band section-rule"></div>
        </div>

        {/* 機材使い放題バナー */}
        <div class="price-hero-banner">
          <div class="zebra-stripe-overlay is-banner" aria-hidden="true"></div>
          <span class="badge-circle-red">機材<br />使い放題</span>
          <p class="banner-copy">どの料金プランでも、<span class="accent-mint">機材は使い放題。</span></p>
        </div>

        {/* 通常帯 */}
        <section class="price-block">
          <header class="section-row">
            <h2 class="t-h3"><span class="pill pill-black">通常帯</span>基本料金（8:00〜23:00）</h2>
            <span class="label-en">DAYTIME</span>
          </header>
          <div class="price-tier-grid">
            {tiers.map((t) => (
              <article
                class={`price-tier-card ${t.primary ? 'card-pop is-primary' : 'card'}`}
                aria-label={`${t.range} ${t.base} 税込${t.incl} 1時間あたり`}
              >
                {t.primary && <div class="zebra-stripe-overlay is-card" aria-hidden="true"></div>}
                <span class={t.primary ? 'pill-red' : 'pill-paper'}>{t.range}</span>
                <div class="price-line">
                  <span class="price-num">{t.base}</span>
                  <span class="price-unit">/ 1h</span>
                </div>
                <div class="price-tax">（税込 <b>{t.incl}</b>）</div>
              </article>
            ))}
          </div>
        </section>

        {/* 深夜帯 */}
        <section class="price-block">
          <header class="section-row">
            <h2 class="t-h3"><span class="pill pill-navy">深夜帯</span>23:00〜翌8:00<span class="muted">通常料金の 50%UP</span></h2>
            <span class="label-en">NIGHT</span>
          </header>
          <article class="card price-night-card">
            {nightRates.map((r) => (
              <div class="price-night-row">
                <span class="row-range">{r.range}</span>
                <span class="row-rate">
                  <span class="price-num-sm">{r.base}</span>
                  <span class="muted">/ 1h（税込 {r.incl}）</span>
                </span>
              </div>
            ))}
          </article>
        </section>

        {/* 最低利用時間 + 追加料金 */}
        <div class="price-block price-twocol-grid">
          <section class="card" aria-labelledby="home-min-hours-h">
            <header class="section-row">
              <h3 id="home-min-hours-h" class="t-h4">最低利用時間</h3>
              <span class="label-en">MIN. HOURS</span>
            </header>
            <ul class="price-rows">
              {minTime.map((m) => (
                <li class="price-row">
                  <span class="row-label">{m.label}</span>
                  <span class="row-value">{m.value}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="card" aria-labelledby="home-addons-h">
            <header class="section-row">
              <h3 id="home-addons-h" class="t-h4">追加料金が発生する場合</h3>
              <span class="label-en">ADD-ONS</span>
            </header>
            <ul class="price-rows">
              {addons.map((a) => (
                <li class="price-row addon-row">
                  <span class="addon-tag">{a.tag}</span>
                  <div>
                    <div>{a.label}</div>
                    <div class="addon-sub muted">{a.sub}</div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        </div>

        <p class="section-cta">
          <a class="btn btn-primary" href="/price/">料金案内はこちら →</a>
        </p>
      </div>
    </section>

    {/* ---------- ABOUT OUR STUDIO ---------- */}
    <section class="home-section home-about">
      <div class="container-narrow">
        <div class="section-head">
          <span class="section-eyebrow">ABOUT OUR STUDIO</span>
          <h2 class="section-title">スタジオゼブラについて</h2>
          <div class="zebra-band section-rule"></div>
        </div>
        <div class="about-grid">
          {reasons.map((r) => (
            <article class="about-card">
              <div class="about-media">
                <Picture
                  src={r.img}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 767px) 100vw, 240px"
                  formats={['avif', 'webp']}
                  alt={r.k}
                  loading="lazy"
                  decoding="async"
                />
                <span class="about-num">{r.n}</span>
              </div>
              <div class="about-body" style={`--accent:${r.accent}`}>
                <span class="about-k" style={`color:${r.kColor}`}>{r.k}</span>
                <h3 class="about-h">{r.title}</h3>
                <p class="about-desc">{r.desc}</p>
                <span class="about-chip">{r.chip}</span>
                <a class="btn btn-secondary about-btn" href={r.to}>{r.cta} →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- RESERVATION ---------- */}
    <section class="home-section home-reserve">
      <div class="container-narrow">
        <div class="section-head">
          <span class="section-eyebrow">RESERVATION</span>
          <h2 class="section-title is-sm">ご予約・お問い合わせ</h2>
          <div class="zebra-band section-rule"></div>
        </div>
        <div class="card-pop reserve-card">
          <p class="reserve-lead">
            空き状況はカレンダーからご確認いただけます。<br />
            はじめての方も、お気軽にお問い合わせください。
          </p>
          <a class="btn btn-primary" href="/reservation/">予約状況のご確認・ご予約はこちら →</a>
        </div>
      </div>
    </section>

    {/* ---------- NEWS ---------- */}
    <section class="home-section home-news">
      <div class="container-narrow">
        <div class="section-head">
          <span class="section-eyebrow">NEWS</span>
          <h2 class="section-title is-sm">お知らせ</h2>
          <div class="zebra-band section-rule"></div>
        </div>
        <ul class="news-list">
          {sortedNews.map((news) => (
            <li class="news-item">
              <a href={`/news/${news.slug}`}>
                <span class="news-date">{formatNewsDate(news.data.pubDate)}</span>
                <span class={`badge ${categoryBadge[news.data.category] ?? 'badge-info'} news-cat`}>{news.data.category}</span>
                <span class="news-title">{news.data.title}</span>
                <span class="news-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="section-cta is-link">
          <a class="news-all" href="/news/">お知らせをすべて見る →</a>
        </p>
      </div>
    </section>

    {/* ---------- ACCESS ---------- */}
    <section class="home-section home-access">
      <div class="container-narrow">
        <div class="section-head">
          <span class="section-eyebrow">ACCESS</span>
          <h2 class="section-title is-sm">アクセス</h2>
          <div class="zebra-band section-rule"></div>
        </div>

        <div class="access-walk-grid">
          {walkCards.map((s) => (
            <div class="walk-card" style={`--accent:${s.accent}`}>
              <div class="walk-line">{s.line}</div>
              <div class="walk-exit">{s.exit}</div>
              <div class="walk-num-row">
                <span class="walk-label">徒歩</span>
                <span class="walk-num">{s.num}</span>
                <span class="walk-unit">分</span>
              </div>
            </div>
          ))}
        </div>

        <div class="access-map-grid">
          <div class="access-map">
            <iframe
              title="スタジオゼブラ 地図"
              src="https://www.google.com/maps?q=東京都渋谷区千駄ヶ谷5-28-10&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="card access-info">
            <div class="label-en">STUDIO ZEBRA</div>
            <p class="access-addr">
              〒151-0051<br />
              渋谷区千駄ヶ谷5-28-10<br />
              ドルミ第2御苑 B101
            </p>
            <p class="access-tel">TEL: 090-6707-0936</p>
            <a class="btn btn-secondary" href="/access/">もっと詳しく →</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style is:global>
  /* =========================================================
     HOME (Design System v2) — すべて .brand-v2.page-home スコープ
     ========================================================= */

  .brand-v2.page-home {
    background: #fff;
  }

  .brand-v2.page-home .home-section {
    padding: var(--s-7) 0;
    background: #fff;
  }

  /* ---------- セクション共通ヘッダー ---------- */
  .brand-v2.page-home .section-head {
    text-align: left;
    margin-bottom: var(--s-6);
  }

  .brand-v2.page-home .section-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 36px;
    line-height: 1.3;
    margin: var(--s-4) 0 var(--s-2);
    color: var(--ink-1);
  }

  .brand-v2.page-home .section-title.is-sm {
    font-size: 26px;
  }

  .brand-v2.page-home .section-rule {
    height: 10px;
    border-radius: 5px;
    margin-top: var(--s-4);
  }

  .brand-v2.page-home .section-cta {
    text-align: center;
    margin: var(--s-6) 0 0;
  }

  .brand-v2.page-home .section-cta.is-link {
    margin-top: var(--s-5);
  }

  /* ---------- HERO ---------- */
  /* nav-header(固定)の高さは画面幅で変化するため、実寸を JS で測って
     --nav-header-h に反映する。下記はJS無効時/初期表示用のフォールバック値。
     （1280px+:96px / 1000-1279px:76px / 768-999px:73px 相当） */
  .brand-v2.page-home {
    --nav-header-h: 96px;
  }

  .brand-v2.page-home .home-hero {
    position: relative;
    background: #fff;
    padding-top: var(--nav-header-h);
  }

  .brand-v2.page-home .hero-stage {
    position: relative;
    height: min(64vh, 560px);
    overflow: hidden;
  }

  .brand-v2.page-home .hero-slides {
    position: absolute;
    inset: 0;
  }

  .brand-v2.page-home .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1000ms ease-in-out;
  }

  .brand-v2.page-home .hero-slide.is-active {
    opacity: 1;
  }

  .brand-v2.page-home .hero-slide picture,
  .brand-v2.page-home .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brand-v2.page-home .hero-slide picture.pc { display: block; }
  .brand-v2.page-home .hero-slide picture.sp { display: none; }

  .brand-v2.page-home .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.6) 42%, rgba(255,255,255,0) 70%);
    pointer-events: none;
  }

  .brand-v2.page-home .hero-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-v2.page-home .hero-copy .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    /* 中央寄せ(margin:0 auto)を解除し、白グラデの左端に寄せる */
    margin-left: 0;
  }

  .brand-v2.page-home .hero-copy .section-eyebrow,
  .brand-v2.page-home .hero-copy .hero-title,
  .brand-v2.page-home .hero-copy .hero-lead {
    margin-left: 0;
    margin-right: auto;
  }

  .brand-v2.page-home .hero-eyebrow {
    align-self: flex-start;
    background: linear-gradient(135deg, #93D2C2 0%, #A8DCE0 50%, #BCE2F4 100%);
    color: var(--ink-1);
  }

  .brand-v2.page-home .hero-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(32px, 5vw, 60px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: var(--s-4) 0 var(--s-2);
    color: var(--ink-1);
    text-align: left;
  }

  .brand-v2.page-home .hero-lead {
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.8;
    margin: var(--s-2) 0 0;
    max-width: 460px;
    text-align: left;
  }

  .brand-v2.page-home .hero-dots {
    position: absolute;
    bottom: 18px;
    right: 24px;
    display: flex;
    gap: var(--s-2);
    z-index: 2;
  }

  .brand-v2.page-home .hero-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--r-pill);
    border: 0;
    padding: 0;
    cursor: pointer;
    background: rgba(26,26,26,0.28);
    transition: width var(--d-trans) var(--ease-out), background var(--d-trans) var(--ease-out);
  }

  .brand-v2.page-home .hero-dot.is-active {
    width: 22px;
    background: var(--brand-red);
  }

  /* ---------- PRICE（price.astro 由来クラスを page-home に複製） ---------- */
  .brand-v2.page-home .price-hero-banner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-5);
    background: var(--brand-black);
    color: #fff;
    border-radius: var(--r-md);
    position: relative;
    overflow: hidden;
  }

  .brand-v2.page-home .badge-circle-red {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-pill);
    background: var(--brand-red);
    color: #fff;
    font-family: var(--font-round);
    font-weight: 800;
    font-size: 13px;
    line-height: 1.2;
    border: 2px solid #fff;
    white-space: nowrap;
  }

  .brand-v2.page-home .banner-copy {
    position: relative;
    flex: 1;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 18px;
    line-height: 1.35;
    margin: 0;
  }

  .brand-v2.page-home .banner-copy .accent-mint {
    color: var(--brand-mint);
  }

  .brand-v2.page-home .section-row {
    display: flex;
