<script>
  // ヒーロースライダー（自前 opacity フェード + ドットナビ）
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.home-hero [data-slide]'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.home-hero [data-dot]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slides.length > 1) {
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (next: number) => {
      slides[current].classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      current = (next + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      dots[current]?.classList.add('is-active');
    };

    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = setInterval(() => show(current + 1), 4500);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        show(index);
        start();
      });
    });

    start();
  }

  // スクロール検知で固定ボタン用クラスを付与（既存挙動を維持）
  const headTop = document.getElementById('head-top');
  const body = document.body;

  if (headTop) {
    const handleScroll = () => {
      if (window.scrollY > headTop.offsetHeight) {
        body.classList.add('fixed-btn');
      } else {
        body.classList.remove('fixed-btn');
      }
    };
    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  // 固定 nav-header の実寸を測り、ヒーローのオフセットに反映（レスポンシブ対応）。
  // nav-header の高さはブレークポイントで変化するため、CSS の固定値ではなく実測する。
  const hero = document.querySelector<HTMLElement>('.brand-v2.page-home .home-hero');
  const navHeader = document.querySelector<HTMLElement>('.nav-header');

  if (hero && navHeader) {
    const isNavVisible = () =>
      window.matchMedia('(min-width: 768px)').matches &&
      getComputedStyle(navHeader).visibility !== 'hidden';

    const syncNavOffset = () => {
      // SP は nav-header 非表示（ハンバーガーのみ）→ オフセット 0
      const offset = isNavVisible() ? navHeader.offsetHeight : 0;
      hero.style.setProperty('--nav-header-h', `${offset}px`);
    };

    syncNavOffset();
    window.addEventListener('resize', syncNavOffset, { passive: true });

    // nav-header の表示/サイズが後から変わる場合に追従
    if ('ResizeObserver' in window) {
      new ResizeObserver(syncNavOffset).observe(navHeader);
    }
  }
</script>
