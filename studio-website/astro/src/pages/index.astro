---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceSection from '../components/sections/index/PriceSection.astro';
import AboutSection from '../components/sections/index/AboutSection.astro';
import NewsSection from '../components/sections/index/NewsSection.astro';
import MapSection from '../components/sections/index/MapSection.astro';
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';

// スライドデータを取得
const slidesData = await getEntry('slides', 'home');

// スライド画像をインポート
import slide01PC from '/public/img/index/slide01_pc_resize.webp';
import slide01SP from '/public/img/index/slide01_sp_resize.webp';
import slide02PC from '/public/img/index/slide02_pc_resize.webp';
import slide02SP from '/public/img/index/slide02_sp_resize.webp';
import slide03PC from '/public/img/index/slide03_pc_resize.webp';
import slide03SP from '/public/img/index/slide03_sp_resize.webp';

// スライド画像マッピング
const slideImages = [
  { pc: slide01PC, sp: slide01SP, width: 2071, height: 1165 },
  { pc: slide02PC, sp: slide02SP, width: 1954, height: 1099 },
  { pc: slide03PC, sp: slide03SP, width: 2407, height: 1354 },
];

// バナー画像をインポート
import bannerTtl from '/public/img/index/banner_ttl.webp';
import bannerBtn from '/public/img/index/banner_btn.webp';
---

<BaseLayout
  title="スタジオゼブラ | 新宿・代々木エリアの白ホリゾント撮影スタジオ"
  showReservationBanner={false}
  pageClass="page-home"
>
  <div id="head-top">
    {slidesData && (
      <div id="key-box">
        <div class="swiper key-slide">
          <div class="swiper-wrapper">
            {slidesData.data.slides.map((slide, index) => (
              <div class="swiper-slide">
                <picture class="pc">
                  <Picture
                    src={slideImages[index].pc}
                    widths={[1024, 1440, 1920, 2400]}
                    sizes="100vw"
                    width={slideImages[index].width}
                    height={slideImages[index].height}
                    formats={['avif', 'webp']}
                    alt={slide.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                </picture>
                <picture class="sp">
                  <Picture
                    src={slideImages[index].sp}
                    widths={[375, 640, 750, 828]}
                    sizes="100vw"
                    width={slideImages[index].width}
                    height={slideImages[index].height}
                    formats={['avif', 'webp']}
                    alt={slide.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                </picture>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
    <div class="head-info">
      <h1 class="logo pc"><a href="/"><img src="/img/shared/logo.webp" alt="新宿エリアのリーズナブルなレンタル撮影スタジオ"></a></h1>
      <div class="box-key">
        <div class="box">
          <p class="text">
            新宿エリア×⾼コスパ<br>
            ⽩ホリスタジオ誕⽣
          </p>
          <p class="btn"><a href="/reservation#cal-box-add"><img src="/img/index/btn_box.webp" alt="予約ボタン"></a></p>
        </div>
        <p class="ttl_key"><img src="/img/index/ttl_key.webp" alt="タイトル画像"></p>
      </div>
      <ul class="nav-h">
        <li><a href="/studio/"><img src="/img/shared/gnav01.webp" alt="スタジオ案内"></a></li>
        <li><a href="/price/"><img src="/img/shared/gnav02.webp" alt="料金案内"></a></li>
        <li><a href="/rental/"><img src="/img/shared/gnav03.webp" alt="レンタル機材"></a></li>
        <li><a href="/access/"><img src="/img/shared/gnav04.webp" alt="アクセス"></a></li>
        <li><a href="/faq/"><img src="/img/shared/gnav_a1.webp" alt="よくある質問"></a></li>
        <li><a href="/horizon/"><img src="/img/shared/gnav_a2.webp" alt="ホリゾントルール"></a></li>
        <li><a href="/reservation/"><img src="/img/shared/gnav05.webp" alt="ご予約・お問い合わせ"></a></li>
        <li><a href="/news/"><img src="/img/shared/gnavi_news.webp" alt="news"></a></li>
        <li><a href="https://twitter.com/studiozebra1st" target="_blank"><img src="/img/shared/gnavi_tw.webp" alt="twitter"></a></li>
      </ul>
    </div>
  </div>
  <section>
    <!-- 料金案内セクション -->
    <PriceSection />

    <!-- スタジオ紹介セクション -->
    <AboutSection />

    <!-- 予約バナー -->
    <div id="banner-pdf">
      <div class="wrap">
        <h2><Picture src={bannerTtl} alt="RESERVATION" loading="lazy" width={400} height={100} formats={['avif', 'webp']} widths={[300, 400, 600]} /></h2>
        <p class="btn"><a class="btn-hover" href="/reservation/"><Picture src={bannerBtn} alt="予約状況のご確認・お問い合わせ・ご予約はこちら" loading="lazy" width={600} height={150} formats={['avif', 'webp']} widths={[400, 600, 800]} /></a></p>
      </div>
    </div>

    <!-- ニュースセクション -->
    <NewsSection />

    <!-- アクセスセクション -->
    <MapSection />
  </section>
</BaseLayout>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style is:global>

  /* key-boxスライダー */
  #key-box {
    position: relative;
    width: 100%;
    z-index: 1;
    /* レイアウトシフト対策: アスペクト比を維持 */
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .key-slide {
    width: 100%;
    height: 100%;
  }

  .key-slide .swiper-slide {
    /* レイアウトシフト対策: スライドの高さを確保 */
    aspect-ratio: 16 / 9;
  }

  .key-slide .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* レイアウトシフト対策: 画像のアスペクト比を明示 */
    aspect-ratio: 16 / 9;
  }

  .key-slide .swiper-slide picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .key-slide .swiper-slide picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* PC用画像を表示、SP用画像を非表示 */
  .key-slide .swiper-slide picture.pc {
    display: block;
  }

  .key-slide .swiper-slide picture.sp {
    display: none;
  }

  /* レスポンシブ対応 - WordPressと同じ幅調整 */
  @media only screen and (max-width: 1199px) {
    /* 画像サイズはaspect-ratioとobject-fitで管理 */
    #key-box {
      aspect-ratio: 16 / 9;
    }

    .head-info .logo a {
      width: 400px;
    }

    .box-key .box {
      max-width: 335px;
      bottom: 26%;
    }

    .box-key .box .text {
      font-size: 28px;
      line-height: 46px;
      margin-bottom: 8px;
      text-align: center;
    }

    .head-info ul {
      width: 635px;
      height: 40px;
      background: url(/img/shared/bg_av_left.webp) no-repeat center left, url(/img/shared/bg_av.webp) no-repeat center right 117px;
      background-size: auto 100%;
      bottom: 20px;
    }

  }

  @media only screen and (max-width: 1025px) {
    /* 画像サイズはaspect-ratioとobject-fitで管理 */
    #key-box {
      aspect-ratio: 16 / 9;
    }

    .box-key .box {
      max-width: 280px;
      bottom: 30%;
    }

    .head-info .logo a {
      width: 400px;
    }

    .box-key .ttl_key {
      max-width: 230px;
    }

    .box-key .box .text {
      font-size: 22px;
      line-height: 36px;
      margin-bottom: 8px;
      text-align: center;
    }

    .head-info ul {
      width: 570px;
      height: 38px;
      background: url(/img/shared/bg_av_left.webp) no-repeat center left, url(/img/shared/bg_av.webp) no-repeat center right 100px;
      background-size: auto 100%;
      bottom: 15px;
    }
  }

  /* head-topの調整 */
  #head-top {
    position: relative;
  }

  /* head-infoをスライダーの上に重ねる */
  .head-info {
    width: 100%;
    box-sizing: border-box;
    padding: 50px 40px 0 40px;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  .head-info > * {
    pointer-events: auto;
  }

  .head-info .logo {
    display: flex;
    justify-content: flex-end;
  }

  .head-info .logo a {
    width: 400px;
    display: block;
  }

  .head-info .logo img {
    width: 100%;
    height: auto;
  }

  /* box-keyのレイアウト */
  .box-key {
    position: relative;
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-top: 50px;
    flex: 1;
    box-sizing: border-box;
  }

  .box-key .box {
    max-width: 300px;
    background: #82C2A9;
    box-sizing: border-box;
    border: 4px solid #333;
    padding: 12px 20px 20px 20px;
    position: absolute;
    bottom: 22%;
    left: 0;
  }

  .box-key .box .text {
    font-size: 24px;
    line-height: 38px;
    font-weight: bold;
    margin: 0 0 15px 0;
    text-align: center;
  }

  .box-key .box .btn {
    margin: 0;
    text-align: center;
  }

  .box-key .box .btn a {
    display: inline-block;
  }

  .box-key .box .btn img {
    max-width: 200px;
    display: block;
    margin: 0 auto;
  }

  .box-key .ttl_key {
    max-width: 250px;
  }

  .box-key img {
    width: 100%;
    height: auto;
  }

  /* nav-hのスタイル */
  .head-info ul {
    width: 750px;
    height: 46px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: url(/img/shared/bg_av_left.webp) no-repeat center left, url(/img/shared/bg_av.webp) no-repeat center right 140px;
    background-size: auto 100%;
    position: absolute;
    bottom: 35px;
    right: 40px;
  }

  .head-info ul li {
    list-style: none;
  }

  .head-info ul li a {
    display: block;
    transition: all 0.4s ease;
  }

  .head-info ul li a img {
    width: 100%;
    height: auto;
  }

  .head-info ul li.active a,
  .head-info ul li:hover a {
    opacity: 0.8;
  }

  @media (max-width: 767px) {
    /* SP版のhead-top調整 */
    #head-top {
      padding-top: 10px;
    }

    .head-info {
      padding: 40px 15px 0 20px;
    }

    /* SP版のbox-key調整 */
    .box-key {
      padding-top: 20px;
    }

    .box-key .ttl_key {
      width: 32%;
    }

    .box-key .box {
      width: 48%;
      max-width: 100%;
      padding: 10px 8px 15px;
      border: 3px solid #333;
      bottom: 5%;
    }

    .box-key .box .text {
      font-size: 3.6vw;
      line-height: 1.8;
      text-align: center;
    }

    /* SP版のレイアウトシフト対策 */
    #key-box {
      aspect-ratio: 4 / 3; /* SP用のアスペクト比 */
    }

    .key-slide .swiper-slide {
      aspect-ratio: 4 / 3;
    }

    .key-slide .swiper-slide img {
      aspect-ratio: 4 / 3;
    }

    /* SP版では画像を切り替え */
    .key-slide .swiper-slide picture.pc {
      display: none;
    }

    .key-slide .swiper-slide picture.sp {
      display: block;
    }

    /* SP版のナビゲーション調整 - モバイルでは非表示 */
    .head-info ul {
      display: none;
    }

    /* 料金セクション - 画像を中央揃え */
    .lead-banner li img {
      width: 100%;
      margin-left: 0;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay } from 'swiper/modules';

  // キースライダーの初期化
  new Swiper('.key-slide', {
    modules: [Autoplay],
    // 自動再生
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
    // ループ
    loop: true,
    // スライド速度
    speed: 800,
  });

  // スクロール検知でHeaderを表示/非表示
  const headTop = document.getElementById('head-top');
  const body = document.body;

  if (headTop) {
    const headTopHeight = headTop.offsetHeight;

    const handleScroll = () => {
      const scrollY = window.scrollY;

      if (scrollY > headTopHeight) {
        body.classList.add('fixed-btn');
      } else {
        body.classList.remove('fixed-btn');
      }
    };

    // 初回実行
    handleScroll();

    // スクロールイベント
    window.addEventListener('scroll', handleScroll, { passive: true });
  }
</script>
