---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';

// 外部サービス・連絡先（現行サイトを踏襲）
const RESERVATION_FORM = 'https://form.run/@studiozebra-1st-reservation';
const LINE_URL = 'https://line.me/R/ti/p/%40190bnuvc';
const TEL_RAW = '09067070936';
const TEL_DISP = '090-6707-0936';
const MAIL = 'studiozebra1st@gmail.com';

// 01 ご予約の流れ
const steps = [
  {
    n: '01',
    t: '予約状況を確認してお申し込み',
    body: 'ご予約カレンダーで空き状況をご確認のうえ、ご予約フォームよりお申し込みをお願いします。',
  },
  {
    n: '02',
    t: '自動返信メール → 受付担当者の返信',
    body: '自動返信メールが届いたら、受付担当者からの返信をお待ちください。',
    em: '受付担当者からの返信をもってご予約の受付完了となります。',
    mail: MAIL,
    notes: [
      '※ 6時間以内に返信がない場合は、お手数ですがご連絡ください。',
      '※ 20時以降のお申し込みは、翌日の正午までに返信いたします。',
    ],
  },
  {
    n: '03',
    t: '予約確定（仮予約／本予約）',
    body: 'お申し込み方法により、予約確定のタイミングが異なります。',
    bullets: [
      { label: '仮予約', em: 'ご利用日の7日前までに予約確定のご連絡をお願いします。', cls: 'mint' },
      { label: '本予約', em: 'その時点で予約確定となり、同時にキャンセル料発生の対象となります。', cls: 'red' },
    ],
  },
] as const;

// 03 予約に関するご案内（用語ピル）
const terms = [
  {
    label: '本予約', cls: 'red',
    parts: [
      { t: '予約が完全に確定している状態です。お申し込み時点で' },
      { t: '予約確定', em: true },
      { t: 'となり、同時に' },
      { t: 'キャンセル料発生の対象', em: true },
      { t: 'となります。' },
    ],
  },
  {
    label: '仮予約', cls: 'mint',
    parts: [
      { t: '正式確定前の一時的な予約です。仮予約は1日のご利用につき最大2日間まで承ります。ご利用日の' },
      { t: '7日前の夕方6時まで', em: true },
      { t: 'に予約確定のご連絡が必要です。' },
      { t: 'ご連絡がない場合はキャンセル扱い', em: true },
      { t: 'となります。' },
    ],
  },
  {
    label: '第2キープ', cls: 'sky',
    parts: [
      { t: 'すでに仮予約が入っている日時への' },
      { t: 'キャンセル待ち', em: true },
      { t: 'です。キャンセルの有無が判明した時点でご連絡を差し上げます（他のお客様が本予約をされている日時へのキャンセル待ちはできません）。' },
    ],
  },
] as const;
---

<BaseLayout
  title="ご予約・お問い合わせ | スタジオゼブラ"
  showReservationBanner={false}
  showFixedReservationButton={false}
>
  <PageHeader
    title="ご予約・お問い合わせ"
    subtitle="<b>ご予約</b>は予約フォームから、<b>お問い合わせ</b>はLINE・お電話で承ります。"
    pageClass="reservation"
    variant="v2"
    eyebrow="RESERVATION"
  />

  <div class="brand-v2 page-reservation">
    <div class="container-narrow">

      <!-- 必読の注意ブロック -->
      <section class="alert-section" aria-label="ご予約前の注意">
        <div class="must-read">
          <span class="must-read-badge" aria-hidden="true">!</span>
          <div>
            <h2 class="must-read-title">ご予約の前に、必ずお読みください</h2>
            <p class="must-read-body">
              当スタジオをご利用いただくには、<a href="/horizon/">ホリゾントルール</a>および<a href="/policy/">利用規約</a>への同意が必要です。内容をご確認のうえ、お申し込みください。
            </p>
          </div>
        </div>
      </section>

      <!-- 01 ご予約の流れ -->
      <section aria-labelledby="sec-flow">
        <header class="section-header">
          <span class="sec-num">01</span>
          <h2 id="sec-flow">ご予約の流れ</h2>
          <span class="label-en">HOW TO RESERVE</span>
        </header>

        <div class="flow-steps">
          {steps.map((s, i) => (
            <div class="flow-step">
              <div class="flow-rail">
                <div class="flow-num">
                  <span class="flow-num-en">STEP</span>
                  <span class="flow-num-n">{s.n}</span>
                </div>
                {i < steps.length - 1 && <div class="flow-connector" aria-hidden="true"></div>}
              </div>
              <div class="card flow-card">
                <h3 class="flow-card-title">{s.t}</h3>
                <p class="flow-card-body">{s.body}</p>

                {s.bullets && (
                  <div class="flow-bullets">
                    {s.bullets.map((bl) => (
                      <div class={`flow-bullet flow-bullet-${bl.cls}`}>
                        <span class={`pill pill-${bl.cls}`}>{bl.label}</span>
                        <span class="flow-bullet-text">{bl.em}</span>
                      </div>
                    ))}
                  </div>
                )}

                {s.em && <p class="flow-em">{s.em}</p>}

                {s.mail && (
                  <p class="flow-mail">
                    スタジオのメールアドレス：<a href={`mailto:${s.mail}`}>{s.mail}</a>
                  </p>
                )}

                {s.notes && s.notes.map((nt) => <p class="flow-note">{nt}</p>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 02 ご予約・お問い合わせの方法 -->
      <section aria-labelledby="sec-contact">
        <header class="section-header">
          <span class="sec-num">02</span>
          <h2 id="sec-contact">ご予約・お問い合わせの方法</h2>
          <span class="label-en">CONTACT</span>
        </header>

        <p class="method-group-label method-group-label-red">ご予約</p>
        <div class="card method-card method-card-form">
          <div class="method-card-text">
            <h3 class="method-title">予約フォーム</h3>
            <p class="method-body">ご予約はこちらから。24時間いつでもご入力いただけます。</p>
          </div>
          <a href={RESERVATION_FORM} target="_blank" rel="noopener" class="btn btn-primary method-btn">
            フォームへ →
          </a>
        </div>

        <p class="method-group-label method-group-label-mint">お問い合わせ</p>
        <div class="method-grid">
          <div class="card method-card-line">
            <h3 class="method-title">LINEでお問い合わせ</h3>
            <p class="method-body">友だち追加のうえ、トークでお気軽にお問い合わせください。</p>
            <a href={LINE_URL} target="_blank" rel="noopener" class="btn btn-secondary method-btn-sm">
              LINEを開く →
            </a>
          </div>
          <div class="card method-card-tel">
            <h3 class="method-title">お電話でお問い合わせ</h3>
            <a href={`tel:${TEL_RAW}`} class="method-tel-num">{TEL_DISP}</a>
            <span class="method-tel-hours">受付時間 10:00〜20:00</span>
          </div>
        </div>
      </section>

      <!-- 03 予約に関するご案内 -->
      <section aria-labelledby="sec-about">
        <header class="section-header">
          <span class="sec-num">03</span>
          <h2 id="sec-about">予約に関するご案内</h2>
          <span class="label-en">ABOUT BOOKING</span>
        </header>

        <div class="card terms-card">
          {terms.map((t, i) => (
            <div class={`term-row ${i === 0 ? 'term-row-first' : ''}`}>
              <span class={`pill pill-${t.cls} term-pill`}>{t.label}</span>
              <p class="term-text">
                {t.parts.map((p) => (
                  p.em ? <span class={`term-em term-em-${t.cls}`}>{p.t}</span> : <span>{p.t}</span>
                ))}
              </p>
            </div>
          ))}
        </div>

        <!-- 詳細な注意事項（現行サイトの実務情報を保持） -->
        <div class="card notice-card">
          <h3 class="notice-title">キャンセル料について</h3>
          <ul class="notice-list">
            <li>ご利用日の<em>6日前〜4日前</em>までのキャンセル料は、ご予約時間分の<em>利用料の50%</em>です。</li>
            <li>ご利用日の<em>3日前〜前日</em>までのキャンセル料は、ご予約時間分の<em>利用料の80%</em>です。</li>
            <li>ご利用日<em>当日</em>のキャンセル、およびご予約当日にご来店がない場合は、ご予約時間分の<em>利用料の100%</em>です。</li>
            <li>キャンセル料のお支払いは、キャンセルより1週間以内に当スタジオにお越しいただき、現金およびクレジットカードにてお支払いいただくか、お振込にてお支払いいただきます。</li>
          </ul>

          <h3 class="notice-title">ロケハンについて</h3>
          <ul class="notice-list">
            <li>ロケハンのお問い合わせは、メールかお電話にてお願いします。</li>
            <li>ロケハンのご予約日に撮影のお申し込みがあった場合、ロケハン日時を変更していただくことがございますので、あらかじめご了承ください。</li>
          </ul>
        </div>

        <p class="about-foot-note">
          ※ キャンセル料は、本予約確定後にご利用日までの日数に応じて発生します。詳しくは<a href="/price/">料金ページのキャンセル料について</a>をご覧ください。
        </p>
      </section>

      <!-- 04 予約カレンダー（ウィジェット組み込み口） -->
      <section aria-labelledby="sec-calendar">
        <header class="section-header">
          <span class="sec-num">04</span>
          <h2 id="sec-calendar">予約カレンダー</h2>
          <span class="label-en">BOOKING CALENDAR</span>
        </header>

        <!-- ウィジェットのマウント先 -->
        <div
          id="zebra-reservation"
          data-studio-id="studio_001"
          data-api-base-url="https://ynnrspq7rl.execute-api.ap-northeast-1.amazonaws.com/dev"
          data-login-url="https://dy4lretixtouu.cloudfront.net/login"
          data-signup-url="https://dy4lretixtouu.cloudfront.net/signup"
        ></div>

        <!-- ウィジェット本体 -->
        <script is:inline defer src="https://dy4lretixtouu.cloudfront.net/widget/zebra-widget.js"></script>

        <p class="about-foot-note">
          ※ 表示はリアルタイム更新ではありません。ご予約希望日に他の予約が入っている場合は、前後1時間以上あけてのご予約をお願いします。
        </p>
      </section>

    </div>
  </div>
</BaseLayout>

<style is:global>
  .brand-v2.page-reservation {
    background: #fff;
    color: var(--ink-1);
    font-family: var(--font-body);
    padding: var(--s-7) 0 var(--s-8);
  }

  /* セクション間の余白 */
  .brand-v2.page-reservation > .container-narrow > section {
    margin-bottom: var(--s-7);
  }
  .brand-v2.page-reservation > .container-narrow > section:last-child {
    margin-bottom: 0;
  }
  .brand-v2.page-reservation > .container-narrow > section.alert-section {
    margin-bottom: var(--s-6);
  }

  /* セクション見出し（番号 + タイトル + 英ラベル）— rental と同等 */
  .brand-v2.page-reservation .section-header {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
    position: static;
    z-index: auto;
  }
  .brand-v2.page-reservation .section-header .sec-num {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--brand-red);
  }
  .brand-v2.page-reservation .section-header h2 {
    flex: 0 1 auto;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--t-h2);
    line-height: 1.3;
  }
  .brand-v2.page-reservation .section-header .label-en {
    margin-left: auto;
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--ink-4);
  }

  /* 共通ピル */
  .brand-v2.page-reservation .pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-pill);
    color: #fff;
    font-family: var(--font-round);
    font-weight: 800;
    text-align: center;
  }
  .brand-v2.page-reservation .pill-red  { background: var(--brand-red); }
  .brand-v2.page-reservation .pill-mint { background: var(--brand-mint); }
  .brand-v2.page-reservation .pill-sky  { background: #5AB4D8; }

  /* ===== 必読の注意ブロック ===== */
  .brand-v2.page-reservation .must-read {
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
    padding: 20px 24px;
    background: var(--accent-soft);
    border: 2px solid var(--brand-red);
    border-radius: var(--r-lg);
  }
  .brand-v2.page-reservation .must-read-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    background: var(--brand-red);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20px;
  }
  .brand-v2.page-reservation .must-read-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 17px;
    margin: 0 0 6px;
    color: var(--brand-red-deep);
  }
  .brand-v2.page-reservation .must-read-body {
    font-size: 14px;
    line-height: 1.85;
    color: var(--ink-1);
    margin: 0;
  }
  .brand-v2.page-reservation .must-read-body a {
    font-weight: 700;
    color: var(--brand-red-deep);
    border-bottom: 2px solid var(--brand-red);
  }

  /* ===== 01 ご予約の流れ ===== */
  .brand-v2.page-reservation .flow-steps {
    display: flex;
    flex-direction: column;
  }
  .brand-v2.page-reservation .flow-step {
    display: flex;
    gap: var(--s-5);
    align-items: stretch;
  }
  .brand-v2.page-reservation .flow-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-v2.page-reservation .flow-num {
    width: 52px;
    height: 52px;
    border-radius: var(--r-pill);
    background: var(--brand-red);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--brand-black);
    box-shadow: 0 3px 0 0 var(--brand-black);
  }
  .brand-v2.page-reservation .flow-num-en {
    font-size: 8px;
    font-family: var(--font-en);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
  }
  .brand-v2.page-reservation .flow-num-n {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.1;
  }
  .brand-v2.page-reservation .flow-connector {
    flex: 1;
    width: 3px;
    background: repeating-linear-gradient(var(--brand-mint) 0 6px, transparent 6px 12px);
    margin: 6px 0;
    min-height: 24px;
  }
  .brand-v2.page-reservation .flow-card {
    flex: 1;
    padding: 20px 24px;
  }
  .brand-v2.page-reservation .flow-step:not(:last-child) .flow-card {
    margin-bottom: var(--s-4);
  }
  .brand-v2.page-reservation .flow-card-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 18px;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .brand-v2.page-reservation .flow-card-body {
    font-size: 14px;
    line-height: 1.85;
    color: var(--ink-2);
    margin: 0;
  }
  .brand-v2.page-reservation .flow-bullets {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }
  .brand-v2.page-reservation .flow-bullet {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 14px;
    border-radius: var(--r-md);
  }
  .brand-v2.page-reservation .flow-bullet-mint {
    background: #E5F2EE;
    border-left: 4px solid var(--brand-mint);
  }
  .brand-v2.page-reservation .flow-bullet-red {
    background: var(--accent-soft);
    border-left: 4px solid var(--brand-red);
  }
  .brand-v2.page-reservation .flow-bullet .pill {
    min-width: 56px;
    padding: 4px 10px;
    font-size: 12px;
  }
  .brand-v2.page-reservation .flow-bullet-text {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.7;
    color: var(--ink-1);
  }
  .brand-v2.page-reservation .flow-em {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.7;
    color: var(--brand-red-deep);
    margin: 10px 0 0;
    padding: 10px 14px;
    background: var(--accent-soft);
    border-radius: var(--r-md);
    border-left: 4px solid var(--brand-red);
  }
  .brand-v2.page-reservation .flow-mail {
    font-size: 13px;
    color: var(--ink-2);
    margin: 10px 0 0;
  }
  .brand-v2.page-reservation .flow-mail a {
    font-weight: 700;
    color: var(--ink-1);
    border-bottom: 1px solid var(--brand-mint);
  }
  .brand-v2.page-reservation .flow-note {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-3);
    margin: 4px 0 0;
  }
  .brand-v2.page-reservation .flow-note:first-of-type {
    margin-top: 10px;
  }

  /* ===== 02 ご予約・お問い合わせの方法 ===== */
  .brand-v2.page-reservation .method-group-label {
    font-family: var(--font-round);
    font-weight: 800;
    font-size: 15px;
    margin: 0 0 10px;
  }
  .brand-v2.page-reservation .method-group-label-red  { color: var(--brand-red); }
  .brand-v2.page-reservation .method-group-label-mint { color: #3B7B6E; margin-top: 28px; }

  .brand-v2.page-reservation .method-card-form {
    padding: 24px;
    display: flex;
    gap: var(--s-5);
    align-items: center;
    border-top: 3px solid var(--brand-red);
  }
  .brand-v2.page-reservation .method-card-text { flex: 1; }
  .brand-v2.page-reservation .method-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 19px;
    margin: 0 0 8px;
  }
  .brand-v2.page-reservation .method-body {
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--ink-2);
    margin: 0;
  }
  .brand-v2.page-reservation .method-btn { flex-shrink: 0; }

  .brand-v2.page-reservation .method-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .brand-v2.page-reservation .method-card-line {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 3px solid var(--brand-mint);
  }
  .brand-v2.page-reservation .method-card-line .method-title { margin: 0; }
  .brand-v2.page-reservation .method-card-line .method-body { margin: 0; }
  .brand-v2.page-reservation .method-btn-sm {
    align-self: flex-start;
    padding: 9px 18px;
    font-size: 13px;
  }
  .brand-v2.page-reservation .method-card-tel {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    border-top: 3px solid #A8DCE0;
  }
  .brand-v2.page-reservation .method-card-tel .method-title { margin: 0 0 4px; }
  .brand-v2.page-reservation .method-tel-num {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 30px;
    color: var(--ink-1);
    line-height: 1.1;
  }
  .brand-v2.page-reservation .method-tel-hours {
    font-size: 13px;
    color: var(--ink-3);
  }

  /* ===== 03 予約に関するご案内 ===== */
  .brand-v2.page-reservation .terms-card {
    padding: 8px 0;
  }
  .brand-v2.page-reservation .term-row {
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
    padding: 18px 24px;
    border-top: 1px solid var(--line-2);
  }
  .brand-v2.page-reservation .term-row-first {
    border-top: 0;
  }
  .brand-v2.page-reservation .term-pill {
    min-width: 84px;
    padding: 6px 12px;
    font-size: 13px;
  }
  .brand-v2.page-reservation .term-text {
    font-size: 14px;
    line-height: 1.95;
    color: var(--ink-2);
