---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
---

<BaseLayout title="アクセス | スタジオゼブラ">
  <PageHeader
    title="アクセス"
    subtitle="代々木駅徒歩3分、新宿駅徒歩7分の好アクセス。<br>利便性と落ち着きを兼ね備えた<br class=&quot;sp&quot;>魅力的なエリアに位置しています。"
    pageClass="access"
    variant="v2"
    eyebrow="ACCESS"
  />

  <section>
    <!-- アクセス情報セクション -->
    <div id="lead-access">
      <div class="wrap">
        <p class="ttl-common wow fadeInUp">スタジオゼブラ</p>
        <h2 class="text wow fadeInUp">〒151-0051 東京都渋谷区千駄ヶ谷5丁目28-10ドルミ第2御苑B101</h2>

        <!-- Googleマップ -->
        <div id="map-access" class="wow fadeInUp">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12962.70066365035!2d139.7039247!3d35.6849996!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xe2a619233d3d372f!2z44K544K_44K444Kq44O844OW44Op!5e0!3m2!1sja!2s!4v1602220734771!5m2!1sja!2s"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

        <!-- アクセス情報（電車・車） -->
        <div class="info-park">
          <div class="list">
            <div class="list train">
              <h3>電車でお越しの方</h3>
              <p class="txt">
                JR代々木駅 東口より徒歩3分。<br>
                JR新宿駅 新南口より徒歩7分。<br>
                東京メトロ丸ノ内線 新宿三丁目駅 E8出口より徒歩5分。<br>
                服部栄養専門学校の向かい、昭和シェル石油の隣の建物です。
              </p>
            </div>
            <div class="list car">
              <h3>お車・バイク・自転車でお越しの方</h3>
              <p class="txt">
                建物は明治通りに面しています。<br>
                当スタジオには駐車場、駐輪場がございませんので近隣の有料パーキングをご利用ください。
              </p>
              <p class="note">
                近隣のパーキングの検索はこちらから
                <span>
                  <a href="https://www.s-park.jp/map?q=〒151-0051%E3%80%80東京都渋谷区千駄ヶ谷5丁目28-10ドルミ第２御苑B101&tab=0&ll=35.684987,139.704181&z=18" target="_blank">
                    <img src="/img/access/icon_s.webp" alt="近隣のパーキングの検索はこちらから">
                  </a>
                </span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 周辺環境セクション -->
    <div id="sec01-access">
      <div class="wrap">
        <h2 class="wow fadeInUp"><span>周辺環境</span></h2>
        <p class="text wow fadeInUp">
          ターミナル駅至近のアクセスの良さに加え、<br class="sp">周辺には便利なお店がいっぱい。<br>
          急な買い出しにも対応できて<br class="sp">ランチのお店探しも楽しい、<br class="sp">撮影にぴったりのエリアです。
        </p>
        <div class="list">
          <div class="item wow fadeInUp">
            <p class="photo">
              <img src="/img/access/access_img1.webp" alt="エキチカ">
              <span>エキチカ</span>
            </p>
            <h3 class="txt">JR代々木駅東口より徒歩3分。JR新宿駅新南口より徒歩7分。東京メトロ新宿三丁目駅E8出口より徒歩5分。</h3>
          </div>
          <div class="item wow fadeInUp">
            <p class="photo">
              <img src="/img/access/access_img2.webp" alt="アクセス抜群">
              <span>アクセス抜群</span>
            </p>
            <h3 class="txt">スタジオは明治通り沿いの分かりやすい場所にあります。服部栄養専門学校の向かい側、昭和シェル石油の隣です。</h3>
          </div>
          <div class="item wow fadeInUp">
            <p class="photo">
              <img src="/img/access/access_img3.webp" alt="お車でも安心">
              <span>お車でも安心</span>
            </p>
            <h3 class="txt">スタジオ周辺には最大料金設定のある駐車場や有料のバイク駐車場・駐輪場があります。</h3>
          </div>
          <div class="item wow fadeInUp">
            <p class="photo">
              <img src="/img/access/access_img4.webp" alt="よりどりみどり">
              <span>よりどりみどり</span>
            </p>
            <h3 class="txt">美味しいランチが楽しめるレストランや、打ち合わせに使えるカフェが充実。近隣にはコンビニや自販機もあり便利です。</h3>
          </div>
          <div class="item wow fadeInUp">
            <p class="photo">
              <img src="/img/access/access_img5.webp" alt="買い出しにも便利">
              <span>買い出しにも便利</span>
            </p>
            <h3 class="txt">ホームセンターや家電量販店、文具店、雑貨屋、薬局・・・徒歩10分圏内に便利なお店が数多くあります。</h3>
          </div>
          <div class="item wow fadeInUp">
            <p class="photo">
              <img src="/img/access/access_img6.webp" alt="撮影準備もスムーズ">
              <span>撮影準備もスムーズ</span>
            </p>
            <h3 class="txt">新宿・渋谷エリアには撮影機材や小道具、衣装をレンタルできるショップが集まっています。</h3>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* アクセス情報セクション */
  #lead-access {
    padding: 60px 0;
    background: #fff;
  }

  #lead-access .ttl-common {
    text-align: center;
    font-size: 36px;
    font-weight: bold;
  }

  #lead-access .text {
    text-align: center;
    font-size: 18px;
    margin-bottom: 40px;
    line-height: 1.8;
    color: #333;
  }

  /* Googleマップ */
  #map-access {
    margin: 40px auto;
    text-align: center;
  }

  #map-access iframe {
    width: 100%;
    max-width: 800px;
    height: 450px;
    border-radius: 8px;
  }

  /* 電車・車のアクセス情報 */
  #lead-access .info-park {
    padding-top: 30px;
  }

  #lead-access .info-park .list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 30px;
  }

  #lead-access .info-park .list .train,
  #lead-access .info-park .list .car {
    border: 4px solid #82C2A9;
    box-sizing: border-box;
    width: calc(50% - 15px);
    padding: 30px;
  }

  #lead-access .info-park .list .train h3,
  #lead-access .info-park .list .car h3 {
    font-size: 22px;
    text-align: center;
    padding-top: 65px;
    background: url(/img/access/icon_t.webp) no-repeat center top;
    background-size: 36px auto;
    margin-bottom: 14px;
  }

  #lead-access .info-park .list .car h3 {
    background: url(/img/access/icon_c.webp) no-repeat center top;
    background-size: 54px auto;
  }

  #lead-access .info-park .list .train .txt,
  #lead-access .info-park .list .car .txt {
    font-size: 16px;
    line-height: 26px;
  }

  #lead-access .info-park .list .train .note,
  #lead-access .info-park .list .car .note {
    font-size: 16px;
    line-height: 26px;
    font-weight: bold;
    text-align: center;
    padding-top: 25px;
  }

  #lead-access .info-park .list .train .note span,
  #lead-access .info-park .list .car .note span {
    width: 234px;
    display: block;
    margin: auto;
  }

  #lead-access .info-park .list .train .note span img,
  #lead-access .info-park .list .car .note span img {
    width: 100%;
    height: auto;
  }

  /* 周辺環境セクション */
  #sec01-access {
    padding: 30px 0;
  }

  #sec01-access h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  #sec01-access h2 span {
    font-size: 36px;
    padding-bottom: 15px;
    border-bottom: 3px solid #82C2A9;
    display: inline-block;
    font-weight: bold;
  }

  #sec01-access > .wrap > .text {
    text-align: center;
    font-size: 16px;
    line-height: 2;
    color: #666;
    margin-bottom: 50px;
  }

  #sec01-access .list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  #sec01-access .item {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #sec01-access .item:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  #sec01-access .item .photo {
    position: relative;
    overflow: hidden;
    height: 200px;
  }

  #sec01-access .item .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #sec01-access .item:hover .photo img {
    transform: scale(1.05);
  }

  #sec01-access .item .photo span {
    position: absolute;
    bottom: 15px;
    left: 15px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
    border-radius: 4px;
  }

  #sec01-access .item .txt {
    padding: 20px;
    font-size: 14px;
    line-height: 1.8;
    color: #666;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    #lead-access .ttl-common {
      font-size: 28px;
    }

    #lead-access .text {
      font-size: 16px;
    }

    #map-access iframe {
      height: 300px;
    }

    #lead-access .info-park .list .train,
    #lead-access .info-park .list .car {
      border: 4px solid #82C2A9;
      box-sizing: border-box;
      width: 100%;
      padding: 25px 20px;
      margin-bottom: 30px;
    }

    #lead-access .info-park .list .train h3,
    #lead-access .info-park .list .car h3 {
      font-size: 20px;
      text-align: center;
      font-weight: bold;
      padding-top: 65px;
      background: url(/img/access/icon_t.webp) no-repeat center top;
      background-size: 36px auto;
      margin-bottom: 14px;
      letter-spacing: -0.05em;
    }

    #lead-access .info-park .list .car h3 {
      background: url(/img/access/icon_c.webp) no-repeat center top;
      background-size: 54px auto;
    }

    #lead-access .info-park .list .train .txt,
    #lead-access .info-park .list .car .txt {
      font-size: 15px;
    }

    #lead-access .info-park .list .train .note,
    #lead-access .info-park .list .car .note {
      font-size: 15px;
    }

    #lead-access .info-park .list .train .note span,
    #lead-access .info-park .list .car .note span {
      width: 234px;
      display: block;
      margin: auto;
    }

    #lead-access .info-park .list .train .note span img,
    #lead-access .info-park .list .car .note span img {
      width: 100%;
      height: auto;
    }

    #sec01-access {
      padding: 0px 0;
    }

    #sec01-access h2 span {
      font-size: 28px;
    }

    #sec01-access > .wrap > .text {
      font-size: 14px;
    }

    #sec01-access .list {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #sec01-access .item .photo {
      height: 180px;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    #sec01-access .list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
