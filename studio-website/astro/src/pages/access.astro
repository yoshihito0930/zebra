---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="アクセス | スタジオゼブラ">
  <div id="head-top" class="page-all access">
    <div class="key-page">
      <h1><span>アクセス</span></h1>
      <h2 class="ttl-key-page"><span>新宿・代々木エリアからアクセス良好</span></h2>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="content-page">
        <h2 class="ttl-common">スタジオゼブラ</h2>
        <p class="address">
          〒151-0051<br>
          東京都渋谷区千駄ヶ谷5丁目28-10<br>
          ドルミ第２御苑B101
        </p>
        <p class="tel">TEL: <a href="tel:09067070936">090-6707-0936</a></p>
        <p class="access-info">
          ・JR「代々木駅」東口より徒歩8分<br>
          ・都営大江戸線「代々木駅」A2出口より徒歩8分<br>
          ・東京メトロ副都心線「北参道駅」1番出口より徒歩10分
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-all.access {
    background: url(/img/common/key_access.jpg) no-repeat center center;
    background-size: cover;
  }
  .content-page {
    padding: 60px 0;
    text-align: center;
  }
  .address {
    margin: 30px 0;
    line-height: 1.8;
  }
  .tel {
    font-size: 18px;
    margin: 20px 0;
  }
  .tel a {
    color: inherit;
  }
  .access-info {
    margin-top: 30px;
    line-height: 2;
  }
</style>
