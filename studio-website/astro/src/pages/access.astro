---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="アクセス | スタジオゼブラ">
  <div id="head-top" class="page-all access">
    <div class="key-page">
      <h1><span>アクセス</span></h1>
      <h2 class="ttl-key-page"><span>新宿・代々木エリアからアクセス良好</span></h2>
    </div>
    <div class="head-info">
      <p class="logo"><a href="/"><img src="/img/shared/logo_fix.png" alt="ロゴ"></a></p>
      <ul class="nav-h">
        <li><a href="/studio/"><img src="/img/shared/gnav01.png" alt="スタジオ案内"></a></li>
        <li><a href="/price/"><img src="/img/shared/gnav02.png" alt="料金案内"></a></li>
        <li><a href="/rental/"><img src="/img/shared/gnav03.png" alt="レンタル機材"></a></li>
        <li class="active"><a href="/access/"><img src="/img/shared/gnav04.png" alt="アクセス"></a></li>
        <li><a href="/faq/"><img src="/img/shared/gnav_a1.png" alt="よくある質問"></a></li>
        <li><a href="/horizon/"><img src="/img/shared/gnav_a2.png" alt="ホリゾントルール"></a></li>
        <li><a href="/reservation/"><img src="/img/shared/gnav05.png" alt="ご予約・お問い合わせ"></a></li>
        <li><a href="/news/"><img src="/img/shared/gnavi_news.png" alt="news"></a></li>
        <li><a href="/blog/"><img src="/img/shared/gnavi_blog.png" alt="ブログ"></a></li>
        <li><a href="https://twitter.com/studiozebra1st" target="_blank"><img src="/img/shared/gnavi_tw.png" alt="twitter"></a></li>
      </ul>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="content-page">
        <h2 class="ttl-common">スタジオゼブラ</h2>
        <p class="address">
          〒151-0051<br>
          東京都渋谷区千駄ヶ谷5丁目28-10<br>
          ドルミ第２御苑B101
        </p>
        <p class="tel">TEL: <a href="tel:09067070936">090-6707-0936</a></p>
        <p class="access-info">
          ・JR「代々木駅」東口より徒歩8分<br>
          ・都営大江戸線「代々木駅」A2出口より徒歩8分<br>
          ・東京メトロ副都心線「北参道駅」1番出口より徒歩10分
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-all.access {
    background: url(/img/common/key_access.jpg) no-repeat center center;
    background-size: cover;
  }
  .content-page {
    padding: 60px 0;
    text-align: center;
  }
  .address {
    margin: 30px 0;
    line-height: 1.8;
  }
  .tel {
    font-size: 18px;
    margin: 20px 0;
  }
  .tel a {
    color: inherit;
  }
  .access-info {
    margin-top: 30px;
    line-height: 2;
  }
</style>
