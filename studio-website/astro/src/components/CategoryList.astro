---
export interface Props {
  categories: string[];
  currentCategory?: string;
}

const { categories, currentCategory } = Astro.props;
---

<div class="category-list">
  <h3>カテゴリ</h3>
  <ul>
    <li class={!currentCategory ? 'active' : ''}>
      <a href="/blog">すべて</a>
    </li>
    {categories.map((category) => (
      <li class={currentCategory === category ? 'active' : ''}>
        <a href={`/blog/category/${encodeURIComponent(category)}`}>
          {category}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .category-list {
    background: #f5f5f5;
    padding: 20px;
    border-radius: 8px;
  }

  .category-list h3 {
    font-size: 18px;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid #82C2A9;
  }

  .category-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .category-list li {
    margin-bottom: 8px;
  }

  .category-list a {
    text-decoration: none;
    color: #333;
    display: block;
    padding: 8px 12px;
    border-radius: 4px;
    transition: background 0.3s;
  }

  .category-list a:hover {
    background: #e0e0e0;
  }

  .category-list li.active a {
    background: #82C2A9;
    color: #fff;
    font-weight: bold;
  }
</style>
