---
export interface Props {
  showReservationBanner?: boolean;
  showFixedReservationButton?: boolean;
}

const {
  showReservationBanner = true,
  showFixedReservationButton = true
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isReservation = currentPath === '/reservation';

// ホームまたは予約ページでは予約バナーを表示しない
const displayReservationBanner = showReservationBanner && !isHome && !isReservation;
// 予約ページでは固定ボタンを表示しない
const displayFixedButton = showFixedReservationButton && !isReservation;

const navItemsPC = [
  { href: '/studio/', label: 'スタジオ案内' },
  { href: '/rental/', label: 'レンタル機材' },
  { href: '/faq/', label: 'よくある質問' },
  { href: '/reservation/', label: 'ご予約・お問い合わせ' },
  { href: '/price/', label: '料金案内' },
  { href: '/access/', label: 'アクセス' },
  { href: '/horizon/', label: 'ホリゾントルール' },
  { href: '/news/', label: 'NEWS' },
  { href: '/policy/', label: '利用規約', target: '_blank' },
];

const navItemsSP = [
  { href: '/studio/', label: 'スタジオ案内' },
  { href: '/rental/', label: 'レンタル機材' },
  { href: '/faq/', label: 'よくある質問' },
  { href: '/price/', label: '料金案内' },
  { href: '/access/', label: 'アクセス' },
  { href: '/horizon/', label: 'ホリゾントルール' },
  { href: '/reservation/', label: 'ご予約・お問い合わせ' },
  { href: '/news/', label: 'NEWS' },
  { href: '/policy/', label: '利用規約', target: '_blank' },
];
---

{displayReservationBanner && (
  <div id="banner-pdf">
    <div class="wrap">
      <h2><img src="/img/index/banner_ttl.webp" alt="RESERVATION"></h2>
      <p class="btn"><a class="btn-hover" href="/reservation/"><img src="/img/index/banner_btn.webp" alt="予約状況のご確認お問い合わせ・ご予約はこちら"></a></p>
    </div>
  </div>
)}
<footer>
  <div class="wrap">
    <p id="to-head"><span class="to-top"><img src="/img/shared/arrow_top.webp" alt="PAGE TOP"></span></p>
    <p class="logo-ft"><a href="/"><img src="/img/shared/logo_ft.webp" alt="ロゴ"></a></p>

    <p class="text"><span>スタジオゼブラ</span>TEL: <a href="tel:09067070936" class="telhref">090-6707-0936</a><br>〒151-0051　東京都渋谷区千駄ヶ谷5丁目28-10ドルミ第２御苑B101</p>
    <div class="nav-ft pc">
      <ul>
        {navItemsPC.map((item) => (
          <li><a href={item.href} target={item.target}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="nav-ft sp">
      <ul>
        {navItemsSP.map((item) => (
          <li><a href={item.href} target={item.target}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <p class="btn"><a class="btn-hover" href="/reservation/"><img src="/img/shared/btn_ft.webp" alt="予約状況のご確認お問い合わせ・ご予約はこちら"></a></p>
    <p class="btn-add"><a href="https://studiokensaku.com/" target="_blank"><img src="/img/shared/banner.webp" alt="スタジオ検索ドットコム"></a></p>
    <div class="twitter-box"><a class="twitter-timeline" href="https://twitter.com/studiozebra1st?ref_src=twsrc%5Etfw">Tweets by studiozebra1st</a></div>
    <address>Copyright©STUDIO ZEBRA All Rights Reserved.</address>
    {displayFixedButton && (
      <p class="fix-left"><a href="/reservation/"><img src="/img/shared/btn_right.webp" alt="ご予約はこちら"></a></p>
    )}
  </div>
</footer>

<!-- ページトップボタン -->
<p id="pagetop">
  <img src="/img/shared/up.webp" alt="最上部へ">
</p>

<style is:global>
  /* Astro独自の最小限の調整のみ - メインスタイルはWordPressのCSSに依存 */
</style>

<script>
  // Twitter Widget読み込み
  const script = document.createElement('script');
  script.src = 'https://platform.twitter.com/widgets.js';
  script.charset = 'utf-8';
  script.async = true;
  document.body.appendChild(script);

  // ページトップボタン
  const pageTopBtn = document.getElementById('pagetop');
  const toTopBtn = document.querySelector('.to-top');

  function togglePageTopButton() {
    if (window.scrollY > 300) {
      pageTopBtn?.classList.add('visible');
    } else {
      pageTopBtn?.classList.remove('visible');
    }
  }

  function scrollToTop() {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  window.addEventListener('scroll', togglePageTopButton);
  pageTopBtn?.addEventListener('click', scrollToTop);
  toTopBtn?.addEventListener('click', scrollToTop);
</script>
