---
export interface Props {
  showReservationBanner?: boolean;
  showFixedReservationButton?: boolean;
}

const {
  showReservationBanner = true,
  showFixedReservationButton = true
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isReservation = currentPath === '/reservation';

// ホームまたは予約ページでは予約バナーを表示しない
const displayReservationBanner = showReservationBanner && !isHome && !isReservation;
// 予約ページでは固定ボタンを表示しない
const displayFixedButton = showFixedReservationButton && !isReservation;

const navItemsPC = [
  { href: '/studio', label: 'スタジオ案内' },
  { href: '/rental', label: 'レンタル機材' },
  { href: '/faq', label: 'よくある質問' },
  { href: '/reservation', label: 'ご予約・お問い合わせ' },
  { href: '/price', label: '料金案内' },
  { href: '/access', label: 'アクセス' },
  { href: '/horizon', label: 'ホリゾントルール' },
  { href: '/news', label: 'NEWS' },
  { href: '/blog', label: 'ブログ' },
  { href: '/policy', label: '利用規約', target: '_blank' },
];

const navItemsSP = [
  { href: '/studio', label: 'スタジオ案内' },
  { href: '/rental', label: 'レンタル機材' },
  { href: '/faq', label: 'よくある質問' },
  { href: '/price', label: '料金案内' },
  { href: '/access', label: 'アクセス' },
  { href: '/horizon', label: 'ホリゾントルール' },
  { href: '/reservation', label: 'ご予約・お問い合わせ' },
  { href: '/news', label: 'NEWS' },
  { href: '/blog', label: 'ブログ' },
  { href: '/policy', label: '利用規約', target: '_blank' },
];
---

{displayReservationBanner && (
  <div id="banner-pdf">
    <div class="wrap">
      <h2><img src="/img/index/banner_ttl.png" alt="RESERVATION"></h2>
      <p class="btn">
        <a class="btn-hover" href="/reservation">
          <img src="/img/index/banner_btn.png" alt="予約状況のご確認お問い合わせ・ご予約はこちら">
        </a>
      </p>
    </div>
  </div>
)}

<footer role="contentinfo">
  <div class="wrap">
    <p id="to-head">
      <button class="to-top" aria-label="ページトップへ戻る">
        <img src="/img/shared/arrow_top.png" alt="PAGE TOP">
      </button>
    </p>

    <p class="logo-ft">
      <a href="/" aria-label="トップページへ戻る">
        <img src="/img/shared/logo_ft.png" alt="スタジオゼブラ ロゴ">
      </a>
    </p>

    <address class="text">
      <span>スタジオゼブラ</span>
      TEL: <a href="tel:09067070936" class="telhref" aria-label="電話番号: 090-6707-0936">090-6707-0936</a><br>
      〒151-0051　東京都渋谷区千駄ヶ谷5丁目28-10ドルミ第２御苑B101
    </address>

    <!-- PC用ナビゲーション -->
    <nav class="nav-ft pc" role="navigation" aria-label="フッターナビゲーション（PC）">
      <ul>
        {navItemsPC.map((item) => (
          <li>
            <a href={item.href} target={item.target}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- SP用ナビゲーション -->
    <nav class="nav-ft sp" role="navigation" aria-label="フッターナビゲーション（SP）">
      <ul>
        {navItemsSP.map((item) => (
          <li>
            <a href={item.href} target={item.target}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="btn">
      <a class="btn-hover" href="/reservation">
        <img src="/img/shared/btn_ft.png" alt="予約状況のご確認お問い合わせ・ご予約はこちら">
      </a>
    </p>

    <p class="btn-add">
      <a href="https://studiokensaku.com/" target="_blank" rel="noopener noreferrer">
        <img src="/img/shared/banner.jpg" alt="スタジオ検索ドットコム">
      </a>
    </p>

    <!-- Twitterタイムライン -->
    <div class="twitter-box">
      <a class="twitter-timeline" href="https://twitter.com/studiozebra1st?ref_src=twsrc%5Etfw">
        Tweets by studiozebra1st
      </a>
    </div>

    <address>Copyright©STUDIO ZEBRA All Rights Reserved.</address>

    {displayFixedButton && (
      <p class="fix-left">
        <a href="/reservation">
          <img src="/img/shared/btn_right.png" alt="ご予約はこちら">
        </a>
      </p>
    )}
  </div>
</footer>

<!-- ページトップボタン -->
<p id="pagetop">
  <img src="/img/shared/up.png" alt="最上部へ">
</p>

<style>
  /* 基本スタイル */
  footer {
    background: #f5f5f5;
    padding: 40px 0;
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .logo-ft {
    text-align: center;
    margin: 20px 0;
  }

  .text {
    text-align: center;
    margin: 20px 0;
    line-height: 1.8;
  }

  .text span {
    font-weight: bold;
    display: block;
  }

  .telhref {
    color: inherit;
    text-decoration: none;
  }

  .nav-ft ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 20px 0;
  }

  .nav-ft li {
    margin: 5px 15px;
  }

  .nav-ft a {
    text-decoration: none;
    color: #333;
    transition: opacity 0.3s;
  }

  .nav-ft a:hover {
    opacity: 0.7;
  }

  .btn, .btn-add {
    text-align: center;
    margin: 20px 0;
  }

  .twitter-box {
    max-width: 600px;
    margin: 30px auto;
  }

  address {
    text-align: center;
    font-style: normal;
    margin-top: 30px;
    font-size: 12px;
    color: #666;
  }

  #to-head {
    text-align: center;
    cursor: pointer;
  }

  .to-top {
    display: inline-block;
    transition: transform 0.3s;
  }

  .to-top:hover {
    transform: translateY(-5px);
  }

  #pagetop {
    position: fixed;
    bottom: 20px;
    right: 20px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  #pagetop.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .fix-left {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 100;
  }

  /* レスポンシブ */
  @media (max-width: 767px) {
    .pc {
      display: none !important;
    }

    .sp {
      display: block;
    }

    .nav-ft ul {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (min-width: 768px) {
    .sp {
      display: none !important;
    }

    .pc {
      display: block;
    }
  }
</style>

<script>
  // Twitter Widget読み込み
  const script = document.createElement('script');
  script.src = 'https://platform.twitter.com/widgets.js';
  script.charset = 'utf-8';
  script.async = true;
  document.body.appendChild(script);

  // ページトップボタン
  const pageTopBtn = document.getElementById('pagetop');
  const toTopBtn = document.querySelector('.to-top');

  function togglePageTopButton() {
    if (window.scrollY > 300) {
      pageTopBtn?.classList.add('visible');
    } else {
      pageTopBtn?.classList.remove('visible');
    }
  }

  function scrollToTop() {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  window.addEventListener('scroll', togglePageTopButton);
  pageTopBtn?.addEventListener('click', scrollToTop);
  toTopBtn?.addEventListener('click', scrollToTop);
</script>
