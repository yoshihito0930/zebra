---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/studio/', label: 'スタジオ案内', imgSrc: '/img/shared/gnav01.webp', page: 'studio' },
  { href: '/price/', label: '料金案内', imgSrc: '/img/shared/gnav02.webp', page: 'price' },
  { href: '/rental/', label: 'レンタル機材', imgSrc: '/img/shared/gnav03.webp', page: 'rental' },
  { href: '/access/', label: 'アクセス', imgSrc: '/img/shared/gnav04.webp', page: 'access' },
  { href: '/faq/', label: 'よくある質問', imgSrc: '/img/shared/gnav_a1.webp', page: 'faq' },
  { href: '/horizon/', label: 'ホリゾントルール', imgSrc: '/img/shared/gnav_a2.webp', page: 'horizon' },
  { href: '/reservation/', label: 'ご予約・お問い合わせ', imgSrc: '/img/shared/gnav05.webp', page: 'reservation' },
  { href: '/news/', label: 'NEWS', imgSrc: '/img/shared/gnavi_news.webp', page: 'news' },
];

const isActive = (page: string) => currentPath.includes(`/${page}`);
const isHome = currentPath === '/';
---

<header class="header-box">
  <p class="logo sp"><a href="/"><img src="/img/shared/logo.webp" alt="ロゴ"></a></p>
  <div class="nav-header">
    <div class="inner">
      <p class="logo-fix pc"><a href="/"><img src="/img/shared/logo_fix.webp" alt="ロゴ"></a></p>
      <ul class="nav">
        <li class={`sp ${isHome ? 'active' : ''}`}><a class="nav-main" href="/"><span class="sp">トップページ</span></a></li>
        {navItems.map((item) => (
          <li class={isActive(item.page) ? 'active' : ''}>
            <a class="nav-main" href={item.href}>
              <img src={item.imgSrc} alt={item.label} class="non-over pc">
              {item.page === 'news' ? (
                <img src={item.imgSrc} alt={item.label} class="sp">
              ) : (
                <span class="sp">{item.label}</span>
              )}
            </a>
          </li>
        ))}
        <li><a href="https://twitter.com/studiozebra1st" target="_blank"><img src="/img/shared/gnavi_tw.webp" alt="twitter"></a></li>
      </ul>
    </div>
  </div>
  <div class="hamberger-btn"><span></span></div>
</header>

<style is:global>
  /* PC版: ナビゲーションを常に表示（index.astro以外） */
  @media only screen and (min-width: 768px) {
    body:not(.page-home) .nav-header {
      opacity: 1 !important;
      visibility: visible !important;
    }
  }

  /* スマホ版: ハンバーガーボタンをCSSで描画 */
  @media only screen and (max-width: 767px) {
    .hamberger-btn {
      position: fixed;
      top: 0;
      right: 0;
      width: 60px;
      height: 60px;
      display: flex !important;
      align-items: center;
      justify-content: center;
      z-index: 201;
      cursor: pointer;
      background: #82C2A9;
      transition: all 0.3s ease;
    }

    .hamberger-btn span {
      display: block !important;
      width: 30px;
      height: 2px;
      background: #fff;
      position: relative !important;
      transition: all 0.3s ease;
      margin: 0;
      padding: 0;
      top: auto !important;
      left: auto !important;
    }

    .hamberger-btn span::before,
    .hamberger-btn span::after {
      content: '';
      display: block !important;
      width: 30px;
      height: 2px;
      background: #fff;
      position: absolute;
      left: 0;
      transition: all 0.3s ease;
    }

    .hamberger-btn span::before {
      top: -10px;
    }

    .hamberger-btn span::after {
      top: 10px;
    }

    /* メニューオープン時はXマークに変形 */
    .menu-open .hamberger-btn span {
      background: transparent !important;
      opacity: 1 !important;
    }

    .menu-open .hamberger-btn span::before {
      top: 0 !important;
      transform: rotate(45deg) !important;
    }

    .menu-open .hamberger-btn span::after {
      top: 0 !important;
      transform: rotate(-45deg) !important;
    }
  }
</style>

<script>
  // ハンバーガーメニュートグル
  const hambergerBtn = document.querySelector('.hamberger-btn');
  const body = document.body;
  let scrollY = 0;

  if (hambergerBtn) {
    hambergerBtn.addEventListener('click', () => {
      if (body.classList.contains('menu-open')) {
        // メニューを閉じる
        body.classList.remove('menu-open');
        body.style.position = '';
        body.style.top = '';
        window.scrollTo({ top: scrollY, behavior: 'instant' });
      } else {
        // メニューを開く
        scrollY = window.pageYOffset;
        body.classList.add('menu-open');
        body.style.position = 'fixed';
        body.style.top = `-${scrollY}px`;
        body.style.width = '100%';
      }
    });
  }
</script>
