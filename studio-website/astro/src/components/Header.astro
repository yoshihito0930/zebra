---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/studio/', label: 'スタジオ案内', imgSrc: '/img/shared/gnav01.png', page: 'studio' },
  { href: '/price/', label: '料金案内', imgSrc: '/img/shared/gnav02.png', page: 'price' },
  { href: '/rental/', label: 'レンタル機材', imgSrc: '/img/shared/gnav03.png', page: 'rental' },
  { href: '/access/', label: 'アクセス', imgSrc: '/img/shared/gnav04.png', page: 'access' },
  { href: '/faq/', label: 'よくある質問', imgSrc: '/img/shared/gnav_a1.png', page: 'faq' },
  { href: '/horizon/', label: 'ホリゾントルール', imgSrc: '/img/shared/gnav_a2.png', page: 'horizon' },
  { href: '/reservation/', label: 'ご予約・お問い合わせ', imgSrc: '/img/shared/gnav05.png', page: 'reservation' },
  { href: '/news/', label: 'NEWS', imgSrc: '/img/shared/gnavi_news.png', page: 'news' },
  { href: '/blog/', label: 'ブログ', imgSrc: '/img/shared/gnavi_blog.png', page: 'blog' },
];

const isActive = (page: string) => currentPath.includes(`/${page}`);
const isHome = currentPath === '/';
---

<header class="header-box">
  <p class="logo sp"><a href="/"><img src="/img/shared/logo.png" alt="ロゴ"></a></p>
  <div class="nav-header">
    <div class="inner">
      <p class="logo-fix pc"><a href="/"><img src="/img/shared/logo_fix.png" alt="ロゴ"></a></p>
      <ul class="nav">
        <li class={`sp ${isHome ? 'active' : ''}`}><a class="nav-main" href="/"><span class="sp">トップページ</span></a></li>
        {navItems.map((item) => (
          <li class={isActive(item.page) ? 'active' : ''}>
            <a class="nav-main" href={item.href}>
              <img src={item.imgSrc} alt={item.label} class="non-over pc">
              <span class="sp">{item.label}</span>
            </a>
          </li>
        ))}
        <li><a href="https://twitter.com/studiozebra1st" target="_blank"><img src="/img/shared/gnavi_tw.png" alt="twitter"></a></li>
      </ul>
    </div>
  </div>
  <div class="hamberger-btn"><span></span></div>
</header>

<style is:global>
  /* Astro独自の最小限の調整のみ - メインスタイルはWordPressのCSSに依存 */
</style>

<script>
  // ハンバーガーメニュートグル
  const hambergerBtn = document.querySelector('.hamberger-btn');
  const navHeader = document.querySelector('.nav-header');

  if (hambergerBtn && navHeader) {
    hambergerBtn.addEventListener('click', () => {
      navHeader.classList.toggle('active');
      hambergerBtn.classList.toggle('active');
    });
  }
</script>
