---
export interface Props {
  categories: string[];
  currentCategory?: string;
  heading: string;
  baseUrl: string;
  allLabel?: string;
}

const {
  categories,
  currentCategory,
  heading,
  baseUrl,
  allLabel = 'すべて',
} = Astro.props;
---

<div class="sidebar-category-list">
  <h3>{heading}</h3>
  <ul>
    <li class={!currentCategory ? 'active' : ''}>
      <a href={baseUrl}>{allLabel}</a>
    </li>
    {categories.map((category) => (
      <li class={currentCategory === category ? 'active' : ''}>
        <a href={`${baseUrl}/category/${encodeURIComponent(category)}`}>{category}</a>
      </li>
    ))}
  </ul>
</div>

<style>
  .sidebar-category-list {
    background: #f5f5f5;
    padding: 20px;
    border-radius: 8px;
  }

  .sidebar-category-list h3 {
    font-size: 18px;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-primary);
  }

  .sidebar-category-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-category-list li {
    margin-bottom: 8px;
  }

  .sidebar-category-list a {
    text-decoration: none;
    color: #333;
    display: block;
    padding: 8px 12px;
    border-radius: 4px;
    transition: background 0.3s;
  }

  .sidebar-category-list a:hover {
    background: #e0e0e0;
  }

  .sidebar-category-list li.active a {
    background: var(--color-primary);
    color: #fff;
    font-weight: bold;
  }
</style>
