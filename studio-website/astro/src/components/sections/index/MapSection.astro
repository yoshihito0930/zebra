---
/**
 * MapSection - アクセスセクション
 * トップページのアクセス・地図セクション（#map-google）
 */
---

<div id="map-google">
  <div class="info-access">
    <h2><img src="/img/index/access_ttl.webp" alt="ACCESS" loading="lazy"></h2>
    <p class="txt">
      〒151-0051<br>
      東京都渋谷区千駄ヶ谷5丁目28-10<br>
      ドルミ第2御苑B101
    </p>
    <p class="btn"><a href="/access/"><img src="/img/index/more.webp" alt="もっと詳しく" loading="lazy"></a></p>
  </div>
  <div class="box">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12962.70066365035!2d139.7039247!3d35.6849996!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xe2a619233d3d372f!2z44K544K_44K444Kq44K844OW44Op!5e0!3m2!1sja!2s!4v1602220734771!5m2!1sja!2s"
      width="600"
      height="450"
      frameborder="0"
      style="border:0;"
      allowfullscreen=""
      aria-hidden="false"
      tabindex="0"
      loading="lazy"
      title="スタジオゼブラの地図"
    ></iframe>
  </div>
</div>

<style>
  /* アクセスセクション */
  #map-google {
    background: var(--color-primary);
    display: flex;
    justify-content: space-between;
    height: 300px;
  }

  #map-google .box {
    width: calc(100% - 315px);
    height: 100%;
  }

  #map-google .box iframe {
    width: 100%;
    height: 100%;
  }

  #map-google .info-access {
    width: 315px;
    height: 100%;
    box-sizing: border-box;
    padding: 55px 0 0 40px;
    line-height: 20px;
    font-weight: bold;
  }

  #map-google .info-access img {
    width: 100%;
    height: auto;
  }

  #map-google .info-access h2 {
    width: 190px;
    margin-bottom: 20px;
  }

  #map-google .info-access .btn {
    width: 230px;
    padding-top: 18px;
  }

  /* レスポンシブ対応 */
  @media only screen and (max-width: 767px) {
    #map-google {
      flex-wrap: wrap;
      height: auto;
    }

    #map-google .box {
      width: 100%;
      height: 300px;
    }

    #map-google .box iframe {
      width: 100%;
      height: 100%;
    }

    #map-google .info-access {
      width: 100%;
      height: auto;
      box-sizing: border-box;
      padding: 55px 0 40px 0px;
      line-height: 20px;
      font-weight: bold;
      text-align: center;
    }

    #map-google .info-access h2 {
      width: 190px;
      margin: 0 auto 25px;
    }

    #map-google .info-access .txt {
      display: inline-block;
      margin: auto;
      text-align: left;
    }

    #map-google .info-access .btn {
      width: 200px;
      margin: auto;
      padding-top: 18px;
    }
  }
</style>
