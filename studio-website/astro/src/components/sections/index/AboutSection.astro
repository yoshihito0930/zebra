---
/**
 * AboutSection - スタジオ紹介セクション
 * トップページのスタジオ紹介セクション（#about）
 */
import { Image } from 'astro:assets';
import titleAbout from '/public/img/index/title_about.webp';
import imgAbout1 from '/public/img/index/img_about1.webp';
import imgAbout2 from '/public/img/index/img_about2.webp';
import imgAbout3 from '/public/img/index/img_about3.webp';
import btnItem02 from '/public/img/index/zebra_240704_item02.webp';
import btnItem03 from '/public/img/index/zebra_240704_item03.webp';
import btnItem04 from '/public/img/index/zebra_240704_item04.webp';
---

<div id="about">
  <div class="wrap">
    <p class="ttl-ab">
      <Image class="pc" src={titleAbout} alt="ABOUT OUR STUDIO" loading="lazy" width={600} height={2000} />
      <span class="sp ttl-common"><img src="/img/index/about_h2_sp.svg" alt="ABOUT OUR STUDIO" loading="lazy"></span>
    </p>
    <div class="list">
      <div class="item">
        <div class="text">
          <p class="ttl-number"><span class="ft-add">01</span>エキチカ！</p>
          <h3 class="txt">
            <span>代々木駅東口より徒歩３分</span><br>
            <span>新宿駅新南口より徒歩７分の好アクセス</span>
          </h3>
          <p class="btn"><a href="/access/"><Image src={btnItem02} alt="アクセス" loading="lazy" width={270} height={100} /></a></p>
        </div>
        <p class="photo"><Image src={imgAbout1} alt="エキチカ！" loading="lazy" width={396} height={300} /></p>
      </div>

      <div class="item">
        <div class="text">
          <p class="ttl-number"><span class="ft-add">02</span>ゆったり！</p>
          <h3 class="txt">
            <span>低価格でもゆとりのある室内</span><br>
            <span>全身撮影にも適した白ホリスタジオ</span>
          </h3>
          <p class="btn"><a href="/studio/"><Image src={btnItem03} alt="スタジオ案内" loading="lazy" width={270} height={100} /></a></p>
        </div>
        <p class="photo"><Image src={imgAbout2} alt="ゆったり！" loading="lazy" width={396} height={300} /></p>
      </div>

      <div class="item">
        <div class="text">
          <p class="ttl-number"><span class="ft-add">03</span>思いのまま！</p>
          <h3 class="txt">
            <span>豊富な機材を無料でお貸し出し</span><br>
            <span>ライティングも思いのままに</span>
          </h3>
          <p class="btn"><a href="/rental/"><Image src={btnItem04} alt="スタジオ機材" loading="lazy" width={270} height={100} /></a></p>
        </div>
        <p class="photo"><Image src={imgAbout3} alt="思いのまま！" loading="lazy" width={396} height={300} /></p>
      </div>
    </div>
  </div>
</div>

<style>
  /* ========================================
     スタジオ紹介セクション (#about)
     ======================================== */

  /* 基本スタイル */
  #about {
    padding: 40px 0 1px;
  }

  #about .wrap {
    max-width: 1100px;
    margin: 0 auto;
  }

  #about .ttl-ab {
    margin-left: 20px;
    width: 30px;
    position: absolute;
    top: 0;
    left: 0;
  }

  #about .ttl-ab img {
    width: 100%;
    height: auto;
  }

  #about .list {
    padding-left: 70px;
  }

  #about .item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
    padding-bottom: 30px;
    margin-bottom: 30px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  #about .item .text {
    width: 48%;
    max-width: 395px;
    background: var(--color-white);
    flex-shrink: 0;
  }

  #about .item .text .ttl-number {
    font-size: 48px;
    margin-bottom: 30px;
    padding-top: 15px;
  }

  #about .item .text .ttl-number span {
    font-size: 60px;
    font-weight: bold;
    color: var(--color-primary);
    text-shadow: var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px, var(--color-black) 0px 0px 2px;
    margin-right: 25px;
    line-height: 60px;
  }

  #about .item .text .txt {
    font-size: 21px;
    line-height: 48px;
    margin-bottom: 28px;
    margin-right: -30px;
  }

  #about .item .text .txt span {
    border-bottom: 2px solid;
    display: inline-block;
    line-height: 40px;
  }

  #about .item .text .btn {
    display: flex;
    justify-content: flex-end;
  }

  #about .item .text .btn a {
    display: block;
    width: 270px;
    margin-top: -20px;
  }

  #about .item .photo {
    width: 48%;
    max-width: 396px;
    flex-shrink: 0;
  }

  #about .item .photo img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: var(--shadow-box);
  }

  /* ========================================
     レスポンシブスタイル
     ======================================== */

  /* タブレット小 (max-width: 899px) */
  @media only screen and (max-width: 899px) {
    #about .ttl-ab {
      left: 3%;
    }
    #about .item .text {
      width: 48%;
    }
    #about .item .photo {
      width: 48%;
    }
    #about .item .text .ttl-number {
      font-size: 38px;
      margin-bottom: 10px;
      padding-top: 5px;
    }
    #about .item .text .ttl-number span {
      font-size: 55px;
      margin-right: 20px;
    }
    #about .item .text .txt {
      font-size: 2.1vw;
      line-height: 42px;
      margin-bottom: 20px;
    }
    #about .item .text .txt span {
      line-height: 36px;
    }
    #about .item .text .btn a {
      width: 270px;
    }
  }

  /* モバイル (max-width: 767px) */
  @media only screen and (max-width: 767px) {
    #about .ttl-ab {
      width: 100%;
      position: static;
      margin-left: 20px;
    }
    #about .ttl-ab span {
      letter-spacing: 0;
      margin-bottom: 30px;
      font-size: 8.5vw;
      margin-right: 20px;
    }
    #about .ttl-ab img {
      width: 100%;
      height: auto;
    }
    #about .list {
      padding-left: 15px;
    }
    #about .item {
      flex-direction: column;
    }
    #about .item .text {
      width: 100%;
      margin-bottom: 30px;
    }
    #about .item .photo {
      max-width: 100%;
      width: 100%;
    }
    #about .item .text .ttl-number {
      font-size: 7vw;
      padding-top: 0;
    }
    #about .item .text .ttl-number span {
      font-size: 14vw;
      line-height: 1;
      margin-right: 18px;
      display: inline;
    }
    #about .item .text .txt {
      font-size: 3.8vw;
      line-height: 40px;
    }
    #about .item .text .txt span {
      border-bottom: 2px solid;
      display: inline-block;
      line-height: 40px;
    }
    #about .item .text .btn {
      display: flex;
      justify-content: flex-end;
    }
    #about .item .text .btn a {
      display: block;
      width: 270px;
    }
  }
</style>
