---
/**
 * PriceSection - 料金案内セクション
 * トップページの料金案内セクション（#lead）
 * スタイルは /styles/global/lead-section.css で定義
 */
import { Image } from 'astro:assets';
import priceItem from '/public/img/index/zebra_240825_item_01.webp';
import leadBtn from '/public/img/index/lead_btn.webp';
---

<div id="lead" class="sec-scroll">
  <div class="wrap">
    <h2 class="ttl-common"><span>新宿・代々木エリアの<br class="sp">白ホリゾント撮影スタジオ</span></h2>

    <ul class="lead-banner">
      <li><Image src={priceItem} alt="料金プラン" loading="lazy" width={800} height={600} /></li>
    </ul>

    <p class="note">
      <span>＊最低利用時間／2時間<br>
      ＊深夜帯（23時〜翌8時）は、通常料金の50%UP<br>
      ＊深夜帯を含む場合の最低利用時間／4時間<br>
      ＊6人以上でのワークショップでご利用・・・合計のご利用料に＋2,200円（税込）<br>
      ＊ラメ、グリッターを多用した衣装・小道具をご使用・・・合計のご利用料に＋2,200円（税込）</span>
    </p>

    <p class="btn"><a class="btn-hover" href="/price/"><Image src={leadBtn} alt="料金案内はこちら" loading="lazy" width={300} height={100} /></a></p>
  </div>
</div>
